<UserControl x:Class="MomentumHunter.Desktop.Wpf.Controls.CommandCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MomentumHunter.Desktop.Wpf.Controls"
             Background="#071522"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CcPanel" Color="#0B1C2A" />
        <SolidColorBrush x:Key="CcPanelAlt" Color="#0E2232" />
        <SolidColorBrush x:Key="CcBorder" Color="#183951" />
        <SolidColorBrush x:Key="CcBlue" Color="#4EA5FF" />
        <SolidColorBrush x:Key="CcGreen" Color="#50DC70" />
        <SolidColorBrush x:Key="CcRed" Color="#F4585C" />
        <SolidColorBrush x:Key="CcAmber" Color="#F0C52E" />
        <Style x:Key="CcPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CcPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource CcBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="CcSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B9CCE0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CcMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#71889C" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="CcListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#143A55" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#102F45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="DispositionTemplate">
            <Border BorderBrush="#17354A" BorderThickness="0,0,0,1" Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="82" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Symbol}" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="{Binding OccurredAtLabel}" Foreground="#6F8799" FontSize="9" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,8,0">
                        <TextBlock Text="{Binding SetupLabel}" Foreground="#A9BDCE" FontSize="10" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Reason}" Foreground="#6F8799" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                    </StackPanel>
                    <controls:MicroChartControl Grid.Column="2" Height="28" Series="{Binding DisplayMiniChart}" ToolTip="{Binding DisplayMiniChart.Limitation}" />
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DisplayFreshness.DisplayFreshnessLabel}" Foreground="#8CCB68" FontSize="9" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding DisplayMiniChart.StateLabel}" Foreground="#6F8799" FontSize="8" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#06111D" BorderBrush="#17344A" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="74" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="MH" FontSize="23" FontWeight="Bold" Foreground="{StaticResource CcBlue}" />
                    <TextBlock Text="ARGUS" FontSize="8" Foreground="#617B91" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Border Background="#0E2940" BorderBrush="{StaticResource CcBlue}" BorderThickness="3,0,0,0" Padding="0,13" Margin="0,2">
                        <StackPanel><TextBlock Text="◎" FontSize="22" Foreground="{StaticResource CcBlue}" HorizontalAlignment="Center" /><TextBlock Text="Console" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                    </Border>
                    <StackPanel Margin="0,13"><TextBlock Text="◉" FontSize="19" Foreground="#7E98AE" HorizontalAlignment="Center" /><TextBlock Text="Radar" FontSize="10" Foreground="#8FA5B8" HorizontalAlignment="Center" /></StackPanel>
                    <StackPanel Margin="0,13"><TextBlock Text="✓" FontSize="19" Foreground="#7E98AE" HorizontalAlignment="Center" /><TextBlock Text="Accepted" FontSize="10" Foreground="#8FA5B8" HorizontalAlignment="Center" /></StackPanel>
                    <StackPanel Margin="0,13"><TextBlock Text="×" FontSize="22" Foreground="#7E98AE" HorizontalAlignment="Center" /><TextBlock Text="Rejected" FontSize="10" Foreground="#8FA5B8" HorizontalAlignment="Center" /></StackPanel>
                    <StackPanel Margin="0,13"><TextBlock Text="▣" FontSize="18" Foreground="#7E98AE" HorizontalAlignment="Center" /><TextBlock Text="Positions" FontSize="10" Foreground="#8FA5B8" HorizontalAlignment="Center" /></StackPanel>
                    <StackPanel Margin="0,13"><TextBlock Text="▥" FontSize="18" Foreground="#7E98AE" HorizontalAlignment="Center" /><TextBlock Text="System" FontSize="10" Foreground="#8FA5B8" HorizontalAlignment="Center" /></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource CcGreen}" FontSize="10" HorizontalAlignment="Center" />
                    <TextBlock Text="READ ONLY" Foreground="#738B9F" FontSize="8" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="12,10,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="1.65*" />
                <RowDefinition Height="0.88*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CcPanelStyle}" Margin="0,0,7,0" Padding="16,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="◎" FontSize="37" Foreground="{StaticResource CcBlue}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="RADAR" Foreground="#72AEE3" FontSize="10" /><TextBlock Text="{Binding CommandCenterRadarCountLabel}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="TRACKED · CURRENT SESSION" Style="{StaticResource CcMuted}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CcPanelStyle}" Margin="0,0,7,0" Padding="16,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="ACCEPTED" Foreground="{StaticResource CcGreen}" FontSize="10" /><TextBlock Text="{Binding CommandCenterAcceptedCountLabel}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="FIRST EXECUTION_ELIGIBLE" Style="{StaticResource CcMuted}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CcPanelStyle}" Margin="0,0,7,0" Padding="16,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="REJECTED" Foreground="{StaticResource CcRed}" FontSize="10" /><TextBlock Text="{Binding CommandCenterRejectedCountLabel}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="QUALIFYING TERMINAL HISTORY" Style="{StaticResource CcMuted}" /></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource CcPanelStyle}" Margin="0,0,7,0" Padding="16,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="SHADOW POSITIONS" Foreground="#72AEE3" FontSize="10" /><TextBlock Text="{Binding OpenPositionCountDisplay}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="FAKEBROKER · READ ONLY" Style="{StaticResource CcMuted}" /></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CcPanelStyle}" Padding="16,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="PROJECTION DATA" Foreground="{StaticResource CcAmber}" FontSize="10" /><TextBlock Text="{Binding CommandCenterDataHealthLabel}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="READ MODEL · NOT HOST HEALTH" Style="{StaticResource CcMuted}" /></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CcPanelStyle}" Margin="0,0,8,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="1*" /><RowDefinition Height="50" /></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="RADAR MAP" Style="{StaticResource CcSectionTitle}" /><TextBlock Text="CURRENT SESSION" Style="{StaticResource CcMuted}" HorizontalAlignment="Right" /></DockPanel>
                        <Grid Grid.Row="1" ClipToBounds="True">
                            <Ellipse Width="265" Height="265" Stroke="#173A56" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="200" Height="200" Stroke="#15334B" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="135" Height="135" Stroke="#15334B" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="65" Height="65" Stroke="#1D5277" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="1" Background="#15334B" HorizontalAlignment="Center" Margin="0,20" />
                            <Border Height="1" Background="#15334B" VerticalAlignment="Center" Margin="20,0" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="230">
                                <TextBlock Text="GEOMETRY PENDING" Foreground="#7992A7" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="No symbol position has been inferred" Foreground="#607A90" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" BorderBrush="#18374D" BorderThickness="0,1,0,0" Padding="0,9,0,0">
                            <TextBlock Text="{Binding CommandCenterRadarMapStatus}" Foreground="{StaticResource CcAmber}" FontSize="9" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CcPanelStyle}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="28" /><RowDefinition Height="1*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
                        <DockPanel Margin="13,0"><TextBlock Text="CROSS-LIFECYCLE RANKED CANDIDATES" Style="{StaticResource CcSectionTitle}" VerticalAlignment="Center" /><TextBlock Text="SOURCE RANK" Foreground="#6C8397" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel>
                        <Grid Grid.Row="1" Background="#0D2130" Margin="7,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="70" /><ColumnDefinition Width="64" /><ColumnDefinition Width="58" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="142" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                            <TextBlock Text="#" Style="{StaticResource CcMuted}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="SYMBOL" Style="{StaticResource CcMuted}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="SCORE" Style="{StaticResource CcMuted}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="RVOL" Style="{StaticResource CcMuted}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="CATALYST / POPULATION" Style="{StaticResource CcMuted}" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="2D · 15m STORED" Style="{StaticResource CcMuted}" VerticalAlignment="Center" /><TextBlock Grid.Column="6" Text="FRESHNESS" Style="{StaticResource CcMuted}" VerticalAlignment="Center" />
                        </Grid>
                        <ListBox Grid.Row="2" ItemsSource="{Binding CommandCenterRankedCandidates}" SelectedItem="{Binding SelectedCommandCenterCandidate, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CcListItem}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#16354B" BorderThickness="0,0,0,1" Padding="7,5"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="70" /><ColumnDefinition Width="64" /><ColumnDefinition Width="58" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="142" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SourceRank}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Symbol}" FontWeight="Bold" /><TextBlock Text="{Binding Company}" Foreground="#657E92" FontSize="8" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ScoreLabel}" Foreground="{StaticResource CcGreen}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding RelativeVolumeLabel}" Foreground="#B0C3D2" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding CatalystSummary}" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding PopulationLabel}" Foreground="#6EA7D4" FontSize="8" /></StackPanel>
                                <controls:MicroChartControl Grid.Column="5" Height="30" Series="{Binding DisplayMiniChart}" ToolTip="{Binding DisplayMiniChart.Limitation}" />
                                <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding DisplayFreshness.DisplayFreshnessLabel}" Foreground="#8DD06C" FontSize="9" /><TextBlock Text="{Binding PriceLabel}" Foreground="#8399AB" FontSize="9" HorizontalAlignment="Right" /></StackPanel>
                            </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="3" Text="{Binding CommandCenterRankedCountLabel}" Foreground="#627C90" FontSize="9" VerticalAlignment="Center" Margin="13,0" />
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="1*" /><RowDefinition Height="8" /><RowDefinition Height="1*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CcPanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="1*" /></Grid.RowDefinitions><Border BorderBrush="#18384E" BorderThickness="0,0,0,1" Padding="12,0"><DockPanel><TextBlock Text="ACCEPTED" Foreground="{StaticResource CcGreen}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="{Binding CommandCenterAcceptedCountLabel}" Foreground="#7D93A5" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel></Border><ItemsControl Grid.Row="1" ItemsSource="{Binding CommandCenterAccepted}" ItemTemplate="{StaticResource DispositionTemplate}" /></Grid></Border>
                    <Border Grid.Row="2" Style="{StaticResource CcPanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="1*" /></Grid.RowDefinitions><Border BorderBrush="#18384E" BorderThickness="0,0,0,1" Padding="12,0"><DockPanel><TextBlock Text="REJECTED" Foreground="{StaticResource CcRed}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="{Binding CommandCenterRejectedCountLabel}" Foreground="#7D93A5" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel></Border><ItemsControl Grid.Row="1" ItemsSource="{Binding CommandCenterRejected}" ItemTemplate="{StaticResource DispositionTemplate}" /></Grid></Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="350" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CcPanelStyle}" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="1*" /></Grid.RowDefinitions><Border BorderBrush="#18384E" BorderThickness="0,0,0,1" Padding="12,0"><DockPanel><TextBlock Text="WHAT CHANGED / RECENT EVENTS" Style="{StaticResource CcSectionTitle}" VerticalAlignment="Center" /><TextBlock Text="{Binding CommandCenterEventHistoryLabel}" Foreground="{StaticResource CcAmber}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel></Border><ItemsControl Grid.Row="1" ItemsSource="{Binding CommandCenterRecentEvents}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="70" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeLabel}" Foreground="#70889B" FontSize="9" /><TextBlock Grid.Column="1" Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="10" /><TextBlock Grid.Column="2" Text="{Binding EventLabel}" Foreground="#68B4ED" FontSize="9" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding Evidence}" Foreground="#7D91A3" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Evidence}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
                <Border Grid.Column="1" Style="{StaticResource CcPanelStyle}" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="1*" /><RowDefinition Height="31" /></Grid.RowDefinitions><Border BorderBrush="#18384E" BorderThickness="0,0,0,1" Padding="12,0"><DockPanel><TextBlock Text="SHADOW POSITIONS" Style="{StaticResource CcSectionTitle}" VerticalAlignment="Center" /><TextBlock Text="FAKEBROKER · READ ONLY" Foreground="#6D879B" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel></Border><ItemsControl Grid.Row="1" ItemsSource="{Binding OpenPositions}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="10,5"><Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="78" /><ColumnDefinition Width="78" /><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding AverageFillDisplay}" Foreground="#9CB0C0" /><TextBlock Grid.Column="2" Text="{Binding ExecutableMarkDisplay}" Foreground="#9CB0C0" /><TextBlock Grid.Column="3" Text="{Binding UnrealizedPnlDisplay}" Foreground="{StaticResource CcGreen}" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="{Binding State}" Foreground="#7591A6" HorizontalAlignment="Right" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Grid.Row="2" Background="#0D2130" Padding="10,0"><DockPanel><TextBlock Text="{Binding PositionsSummary}" Foreground="#688195" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding OpenPositionPnlDisplay}" Foreground="{StaticResource CcGreen}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel></Border></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource CcPanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="1*" /></Grid.RowDefinitions><Border BorderBrush="#18384E" BorderThickness="0,0,0,1" Padding="12,0"><TextBlock Text="SYSTEM CONTEXT" Style="{StaticResource CcSectionTitle}" VerticalAlignment="Center" /></Border><StackPanel Grid.Row="1" Margin="12,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SESSION" Style="{StaticResource CcMuted}" /><TextBlock Text="{Binding CommandCenterSessionLabel}" FontSize="14" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LAST UPDATE" Style="{StaticResource CcMuted}" /><TextBlock Text="{Binding CommandCenterLastUpdateLabel}" FontSize="14" /></StackPanel></Grid><Separator Background="#19384E" Margin="0,8" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HOST HEALTH" Style="{StaticResource CcMuted}" /><TextBlock Text="{Binding CommandCenterHostHealthLabel}" Foreground="#8FB4CF" FontSize="10" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PROJECTION DATA" Style="{StaticResource CcMuted}" /><TextBlock Text="{Binding CommandCenterDataHealthLabel}" Foreground="{StaticResource CcAmber}" FontSize="10" /></StackPanel></Grid><TextBlock Text="SOURCE MODE" Style="{StaticResource CcMuted}" Margin="0,7,0,0" /><TextBlock Text="{Binding CommandCenterEvidenceModeLabel}" Foreground="#8FB4CF" FontSize="10" Margin="0,2,0,7" /><TextBlock Text="LIMITATIONS" Style="{StaticResource CcMuted}" /><TextBlock Text="{Binding CommandCenterLimitationsLabel}" Foreground="{StaticResource CcAmber}" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="58" ToolTip="{Binding CommandCenterLimitationsLabel}" /><Border Background="#10293B" CornerRadius="4" Margin="0,7,0,0" Padding="8"><TextBlock Text="Charts and freshness are human context only. They have no ranking, scoring, readiness, risk, entry, exit, or execution authority." Foreground="#7892A6" FontSize="9" TextWrapping="Wrap" /></Border></StackPanel></Grid></Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
