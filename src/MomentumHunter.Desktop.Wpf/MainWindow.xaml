                    <avalon:LayoutAnchorablePane DockHeight="180" DockMinHeight="90">
                        <avalon:LayoutAnchorable x:Name="ActivityAnchor" ContentId="pane-activity" Title="Activity" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                    <ListBox ItemsSource="{Binding ActivityRows}" Background="#17212B" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                        <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" Foreground="{StaticResource Teal}" FontSize="10" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ScopeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="{Binding StateLabel}" Margin="10,0,0,0" FontSize="10" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StateLabel}" Value="HEALTHY">
                                                                            <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StateLabel}" Value="DEGRADED">
                                                                            <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StateLabel}" Value="UNAVAILABLE">
                                                                            <Setter Property="Foreground" Value="#F2868D" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ActivityCountLabel}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ActivitySourceLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="Newest source event appears first. Displaying this stream does not create, reorder, or persist events." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <Button Content="Diagnostics" Click="DiagnosticsButton_Click" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="DiagnosticsAnchor" ContentId="pane-diagnostics" Title="Diagnostics" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Diagnostics" FontSize="16" FontWeight="SemiBold" />
                                        <Border DockPanel.Dock="Right" Padding="7,3" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#263846" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Diagnostics.StatusLabel}" Value="HEALTHY">
                                                            <Setter Property="Background" Value="#173C37" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Diagnostics.StatusLabel}" Value="DEGRADED">
                                                            <Setter Property="Background" Value="#3A3524" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Diagnostics.StatusLabel}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Diagnostics.StatusLabel}" Value="HEALTHY">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Diagnostics.StatusLabel}" Value="DEGRADED">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" Margin="0,5,0,9">
