                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource PanelBorder}"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                                <StackPanel>
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="150" />
                                                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Teal}" FontWeight="SemiBold" FontSize="10" Width="220" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding TimeframeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="75" />
                                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource Amber}" FontSize="10" Width="130" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding QualityLabel}" Foreground="{StaticResource TextPrimary}" FontSize="10" Width="80" />
                                                                        <TextBlock Text="{Binding EventIdLabel, StringFormat=ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding MetricsLabel}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding Notes}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{Binding TechnicalResearchEventsEmptyLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="24">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTechnicalResearchEvents}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Outcome Studies">
                                            <Grid Background="#17212B">
                                                <ListBox ItemsSource="{Binding TechnicalResearchStudyRows}"
                                                         Background="#17212B"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource PanelBorder}"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                                <StackPanel>
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="150" />
                                                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Teal}" FontWeight="SemiBold" FontSize="10" Width="220" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding TimeframeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="75" />
                                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource Amber}" FontSize="10" Width="130" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding EventIdLabel, StringFormat=ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding ReturnsLabel}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding ExcursionLabel}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                    <TextBlock Text="{Binding FlagsLabel}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                    <TextBlock Text="{Binding Notes}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{Binding TechnicalResearchStudiesEmptyLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="24">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTechnicalResearchStudies}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="WatchlistAnchor" ContentId="pane-watchlist" Title="Watchlist" CanClose="True" CanFloat="True">
