                                                        <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="BLOCKED">
                                                            <Setter Property="Background" Value="#47272B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MonitoringStatus.StateLabel}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="HEALTHY">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="DEGRADED">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="PAUSED">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="BLOCKED">
