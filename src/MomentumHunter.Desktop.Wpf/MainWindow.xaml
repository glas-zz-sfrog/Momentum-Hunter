                                                                            <TextBlock Text="{Binding CompanyLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                                <WrapPanel Grid.Row="1" Margin="34,7,0,0">
                                                                    <TextBlock Text="{Binding VolumeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,16,0" />
                                                                    <TextBlock Text="{Binding ClassificationLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,16,0" />
                                                                    <TextBlock Text="{Binding FreshnessLabel}" Foreground="{StaticResource Amber}" FontSize="10" Margin="0,0,16,0" />
                                                                    <TextBlock Text="{Binding SavedAtLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                                </WrapPanel>
                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding HeadlineLabel}"
                                                                           Foreground="{StaticResource TextPrimary}"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap"
                                                                           Margin="34,7,0,0" />
