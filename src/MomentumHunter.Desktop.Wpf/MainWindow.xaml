<Window x:Class="MomentumHunter.Desktop.Wpf.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:controls="clr-namespace:MomentumHunter.Desktop.Wpf.Controls"
        xmlns:contracts="clr-namespace:MomentumHunter.Contracts;assembly=MomentumHunter.Contracts"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Momentum Hunter Workstation"
        Icon="Assets/MomentumHunter.ico"
        Height="920"
        Width="1440"
        MinHeight="650"
        MinWidth="1120"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Activated="Window_Activated"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ShadowFilterComboStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#1A2731" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid MinHeight="27">
                            <ToggleButton Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Grid IsHitTestVisible="False" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="▼" Foreground="{StaticResource TextMuted}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#1A2731"
                                        BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarIconButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="10000" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="TopBarButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="EnvironmentBadgeStyle" TargetType="{x:Type Label}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#203A38" />
            <Setter Property="Foreground" Value="{StaticResource Teal}" />
            <Setter Property="BorderBrush" Value="#315A55" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Label}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentLabel}" Value="LIVE MONEY">
                    <Setter Property="Background" Value="#A51D22" />
                    <Setter Property="BorderBrush" Value="#FF6B70" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowCaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <Border x:Name="KeyboardFocusCue"
                                        Margin="3"
                                        BorderBrush="{StaticResource Teal}"
                                        BorderThickness="1"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeyboardFocusCue" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#253440" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#31404E" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#8F1D14" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border x:Name="IntegratedTitleBar"
                Grid.Row="0"
                Background="#121C24"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1"
                AutomationProperties.Name="Momentum Hunter integrated title bar">
            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MOMENTUM HUNTER"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Current" Tag="Live" Style="{StaticResource TopBarButtonStyle}" Click="WorkspaceButton_Click" />
                    <Button Content="Replay" Tag="Replay" Style="{StaticResource TopBarButtonStyle}" Click="WorkspaceButton_Click" />
                    <Button Content="Review" Tag="Review" Style="{StaticResource TopBarButtonStyle}" Click="WorkspaceButton_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="1m" Tag="1m" Style="{StaticResource TopBarButtonStyle}" Click="IntervalButton_Click" />
                    <Button Content="5m" Tag="5m" Style="{StaticResource TopBarButtonStyle}" Click="IntervalButton_Click" />
                    <Button Content="15m" Tag="15m" Style="{StaticResource TopBarButtonStyle}" Click="IntervalButton_Click" />
                    <Button Content="Daily" Tag="Daily" Style="{StaticResource TopBarButtonStyle}" Click="IntervalButton_Click" />
                </StackPanel>
                <Button Grid.Column="3"
                        Style="{StaticResource ToolbarIconButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ToolTip="Search current Hunter symbols and commands (Ctrl+K)"
                        AutomationProperties.HelpText="Search current Hunter symbols and commands. Keyboard shortcut Control K."
                        AutomationProperties.Name="Open Command Palette"
                        Click="OpenCommandPaletteButton_Click">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                </Button>
                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            ToolTip="Save current workspace layout"
                            AutomationProperties.HelpText="Save current workspace layout."
                            AutomationProperties.Name="Save layout"
                            Click="SaveLayoutButton_Click">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            ToolTip="Restore the last saved workspace layout"
                            AutomationProperties.HelpText="Restore the last saved workspace layout."
                            AutomationProperties.Name="Restore layout"
                            Click="RestoreLayoutButton_Click">
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                    </Button>
                    <Button x:Name="PanesButton" Content="Panes" Style="{StaticResource TopBarButtonStyle}" Click="PanesButton_Click" />
                </StackPanel>
                <Label x:Name="EnvironmentBadge"
                       Grid.Column="6"
                       Content="{Binding EnvironmentLabel}"
                       ToolTip="{Binding EnvironmentDetail}"
                       AutomationProperties.Name="{Binding EnvironmentLabel}"
                       Style="{StaticResource EnvironmentBadgeStyle}" />
                <Button Grid.Column="7"
                        Content="{Binding PositionsButtonLabel}"
                        ToolTip="{Binding PositionsButtonToolTip}"
                        AutomationProperties.Name="Open positions"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="PositionsButton_Click" />
                <Button Grid.Column="8"
                        Content="{Binding ActivityLabel}"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="ActivityButton_Click" />
                <Button x:Name="HealthButton"
                        Grid.Column="9"
                        Content="Health"
                        Style="{StaticResource TopBarButtonStyle}"
                        Command="{Binding ToggleHealthCommand}" />
                <Button x:Name="ApplicationMenuButton"
                        Grid.Column="10"
                        Content="Menu"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="ApplicationMenuButton_Click" />
                <Button x:Name="MinimizeWindowButton"
                        Grid.Column="11"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        ToolTip="Minimize"
                        AutomationProperties.Name="Minimize window"
                        Click="MinimizeWindowButton_Click">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="MaximizeRestoreWindowButton"
                        Grid.Column="12"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        ToolTip="Maximize"
                        AutomationProperties.Name="Maximize window"
                        Click="MaximizeRestoreWindowButton_Click">
                    <TextBlock x:Name="MaximizeRestoreGlyph"
                               Text="&#xE922;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10" />
                </Button>
                <Button x:Name="CloseWindowButton"
                        Grid.Column="13"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Close"
                        AutomationProperties.Name="Close window"
                        Click="CloseWindowButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <avalon:DockingManager x:Name="DockManager" Grid.Row="1" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource PanelBorder}">
            <avalon:DockingManager.Theme>
                <themes:Vs2013DarkTheme />
            </avalon:DockingManager.Theme>
            <avalon:LayoutRoot>
                <avalon:LayoutPanel Orientation="Vertical">
                    <avalon:LayoutPanel Orientation="Horizontal">
                        <avalon:LayoutAnchorablePane DockWidth="310">
                            <avalon:LayoutAnchorable x:Name="HunterAnchor" ContentId="pane-hunter" Title="Hunter" CanClose="True" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding WorkspaceTitle}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Grid.Row="1" Text="{Binding WorkspaceNarrative}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <ListBox x:Name="CandidateGrid"
                                                 Grid.Row="2"
                                                 ItemsSource="{Binding Candidates}"
                                                 SelectedItem="{Binding SelectedCandidate, Mode=OneWay}"
                                                 SelectionChanged="CandidateGrid_SelectionChanged"
                                                 Background="#17212B"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 BorderBrush="{StaticResource PanelBorder}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="5,5,5,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Row="0" Grid.Column="0" Content="{Binding Score}" Tag="{Binding}" Click="CandidateScoreButton_Click" Padding="2" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Symbol}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LastPrice, StringFormat={}{0:C2}}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ChangePercent, StringFormat={}{0:+0.0;-0.0;0.0}%}" Foreground="{StaticResource Teal}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="2,4,4,0" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding RelativeVolume, StringFormat=RVOL {0:N1}x}" />
                                                            <Run Text=" | " />
                                                            <Run Text="{Binding FloatOrLiquidity}" />
                                                            <Run Text=" | " />
                                                            <Run Text="{Binding Catalyst}" />
                                                        </TextBlock>
                                                        <Border Grid.Row="1" Grid.Column="3" Background="#263846" CornerRadius="3" Padding="5,2" Margin="4,4,0,0" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding OperatorState}" Foreground="{StaticResource Teal}" FontSize="10" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>

                        <avalon:LayoutDocumentPane x:Name="ChartDocumentPane">
                            <avalon:LayoutDocument x:Name="PrimaryChartDocument" ContentId="pane-primary-chart" Title="Chart" CanClose="False" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border Padding="7,3" Margin="4,0" Background="#263846" CornerRadius="3">
                                                    <TextBlock Text="{Binding PrimaryChartLinkLabel}" Foreground="{StaticResource Teal}" FontSize="11" />
                                                </Border>
                                                <Button Content="Link" Command="{Binding CyclePrimaryChartLinkGroupCommand}" />
                                                <Button Content="Pin" Command="{Binding TogglePrimaryChartPinCommand}" />
                                                <Button Content="New Chart" Click="NewChartButton_Click" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding PrimaryChart.Pane.Symbol}" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ChartSourceLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ChartSourceLabel}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <controls:CandleChart Grid.Row="1"
                                                              Candles="{Binding PrimaryChart.Candles}"
                                                              EmptyStateText="{Binding PrimaryChart.EmptyStateText}"
                                                              Interval="{Binding PrimaryChart.Pane.Interval}"
                                                              InspectedCandle="{Binding PrimaryChart.InspectedBar, Mode=TwoWay}"
                                                              Margin="0,12,0,8" />
                                        <Border Grid.Row="2"
                                                BorderBrush="{StaticResource PanelBorder}"
                                                BorderThickness="0,1,0,0"
                                                Padding="0,7,0,6">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding PrimaryChart.ActiveBarLabel}"
                                                           Foreground="{StaticResource Teal}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding PrimaryChart.ActiveBarSummary}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding PrimaryChart.ActiveBarSummary}" />
                                            </DockPanel>
                                        </Border>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                                            <TextBlock Text="Research display only" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            <TextBlock Text="  |  Linked panes update only within their selected link group" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </avalon:LayoutDocument>
                        </avalon:LayoutDocumentPane>

                        <avalon:LayoutAnchorablePane DockWidth="340">
                            <avalon:LayoutAnchorable x:Name="TradePlanAnchor" ContentId="pane-trade-plan" Title="Trade Plan" CanClose="True" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Trade Plan" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TradePlanSymbolLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Border Padding="7,3" Margin="0,0,4,0" Background="#263846" CornerRadius="3">
                                                    <TextBlock Text="{Binding PrimaryTradePlanLinkLabel}" Foreground="{StaticResource Teal}" FontSize="10" />
                                                </Border>
                                                <Button Content="Pin" Command="{Binding TogglePrimaryTradePlanPinCommand}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding PlanningStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,2" />
                                        <TabControl Grid.Row="2" Margin="0,12,0,0" Background="#17212B" Foreground="{StaticResource TextPrimary}" SelectedIndex="{Binding TradePlanTabIndex}">
                                            <TabItem Header="Plan">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="8">
                                                        <UniformGrid Columns="2" Margin="0,0,0,12">
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Entry" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.EntryDisplay}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Stop" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.StopDisplay}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Target" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.TargetDisplay}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Reward/Risk" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.RewardToRiskDisplay}" FontSize="16" /></StackPanel>
                                                        </UniformGrid>
                                                        <TextBlock Text="Readiness Gate" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                        <ItemsControl ItemsSource="{Binding TradePlan.Checks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding TradePlan.RiskDecision.Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                        <Button Content="{Binding PrimaryActionLabel}" IsEnabled="{Binding CanRunPrimaryAction}" Click="TradePlanActionButton_Click" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Why">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="12">
                                                        <TextBlock Text="{Binding CandidateEvidenceSymbolLabel}" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock Text="Persisted catalyst" Foreground="{StaticResource Teal}" FontSize="11" Margin="0,12,0,3" />
                                                        <TextBlock Text="{Binding CandidateCatalystHeadline}" TextWrapping="Wrap" FontSize="13" />
                                                        <TextBlock Text="{Binding CandidateCatalystSourceLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,5,0,0" />
                                                        <TextBlock Text="{Binding CandidateCatalystObservedAtLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                        <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,10" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="92" />
                                                                <ColumnDefinition Width="1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source state" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,8,7" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CandidateReadinessLabel}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Liquidity" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CandidateLiquidityLabel}" TextWrapping="Wrap" />
                                                        </Grid>
                                                        <TextBlock Text="Persisted evidence disclosure only; this is not a trade recommendation." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0" />
                                                        <StackPanel Margin="0,14,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedShadowTrade}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Margin="0,0,0,10" />
                                                            <TextBlock Text="Frozen test-trade context" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SelectedShadowTrade.Setup, StringFormat=Setup: {0}}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SelectedShadowTrade.Catalyst, StringFormat=Catalyst: {0}}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SelectedShadowTrade.Identity.MarketRegime, StringFormat=Market regime: {0}}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.ReasonDisplay}" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Research">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="12">
                                                        <TextBlock Text="Evidence quality" Foreground="{StaticResource Teal}" FontSize="11" />
                                                        <TextBlock Text="{Binding CandidateQualityLabel}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        <TextBlock Text="Source lineage" Foreground="{StaticResource Teal}" FontSize="11" Margin="0,14,0,3" />
                                                        <TextBlock Text="{Binding CandidateLineageSourceLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding CandidateLineageAsOfLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                        <TextBlock Text="{Binding CandidateLineageSummary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                        <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,10" />
                                                        <TextBlock Text="Opportunity notes" Foreground="{StaticResource Teal}" FontSize="11" />
                                                        <TextBlock Text="{Binding CandidateOpportunityNotesLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,5" />
                                                        <ItemsControl ItemsSource="{Binding CandidateOpportunityNotes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,5">
                                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="Read-only research evidence. No score, readiness, alert, or execution rule is recalculated here." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0" />
                                                        <TextBlock Text="Technical details are intentionally a disclosure, not a trade recommendation." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="History">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="12">
                                                        <StackPanel>
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedShadowTrade}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="Test-trade history" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding SelectedShadowTrade.Execution.LifecycleState, StringFormat=Lifecycle: {0}}" Margin="0,8,0,0" />
                                                            <TextBlock Text="{Binding SelectedShadowTrade.Execution.LastReason}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SelectedShadowTrade.Execution.Quality.Summary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Text="No order or broker history exists in this simulation-only shell." TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedShadowTrade}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </Border>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>
                    </avalon:LayoutPanel>

                    <avalon:LayoutAnchorablePane DockHeight="520" DockMinHeight="300">
                        <avalon:LayoutAnchorable x:Name="CandidateStoryAnchor" ContentId="pane-candidate-story" Title="Candidate Story" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Candidate Story" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CandidateStoryOverview.Symbol}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CandidateStoryOverview.CompanyContext}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#253440" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8,4">
                                            <TextBlock Text="{Binding CandidateStoryOverview.State}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1" Background="#121C24" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,10,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CandidateStoryOverview.Status}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Teal}" />
                                                <TextBlock Text="{Binding CandidateStoryOverview.StatusDetail}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,12,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CandidateStoryOverview.Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2">
                                        <WrapPanel>
                                            <Border Width="210" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="First Seen" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.FirstSeen}" TextWrapping="Wrap" /></StackPanel>
                                            </Border>
                                            <Border Width="210" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="Latest" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.LatestSeen}" TextWrapping="Wrap" /></StackPanel>
                                            </Border>
                                            <Border Width="150" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="Move" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.Move}" /></StackPanel>
                                            </Border>
                                            <Border Width="165" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="Score Path" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.ScorePath}" /></StackPanel>
                                            </Border>
                                            <Border Width="230" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="Peak Score" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.PeakScore}" TextWrapping="Wrap" /></StackPanel>
                                            </Border>
                                            <Border Width="170" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                                                <StackPanel><TextBlock Text="Evidence" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.CaptureCount}" /></StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <DataGrid ItemsSource="{Binding CandidateStoryRows}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  AlternationCount="2"
                                                  Background="#17212B"
                                                  BorderBrush="{StaticResource PanelBorder}"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="38" />
                                                <DataGridTextColumn Header="Captured At" Binding="{Binding CapturedAt}" Width="175" />
                                                <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="60" />
                                                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="80" />
                                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="58" />
                                                <DataGridTextColumn Header="Move From First" Binding="{Binding MoveFromFirst}" Width="105" />
                                                <DataGridTextColumn Header="RVOL" Binding="{Binding RelativeVolume}" Width="68" />
                                                <DataGridTextColumn Header="Capture-Time Fact" Binding="{Binding CaptureNote}" Width="180" />
                                                <DataGridTextColumn Header="Later Annotation" Binding="{Binding LaterAnnotation}" Width="280" />
                                                <DataGridTextColumn Header="Source Context" Binding="{Binding SourceContext}" Width="320" />
                                                <DataGridTextColumn Header="Trust" Binding="{Binding Trust}" Width="200" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{Binding CandidateStoryEmptyLabel}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCandidateStoryPoints}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Grid.Row="4" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CandidateStoryOverview.Source}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CandidateStoryOverview.AsOf}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="READ ONLY | Capture-time facts and later annotations remain separately labeled." Foreground="{StaticResource Teal}" FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ScrollViewer Grid.Column="1" MaxHeight="54" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding CandidateStoryOverview.Warnings}" Foreground="{StaticResource Amber}" FontSize="10" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                     </Grid>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>

                    <avalon:LayoutAnchorablePane DockHeight="560" DockMinHeight="320">
                        <avalon:LayoutAnchorable x:Name="ResearchMaturityAnchor"
                                                  ContentId="pane-research-maturity"
                                                  Title="Research Maturity"
                                                  CanClose="True"
                                                  CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="14">
                                <Border.Resources>
                                    <Style x:Key="ResearchMaturityColumnHeaderStyle"
                                           TargetType="{x:Type DataGridColumnHeader}">
                                        <Setter Property="Foreground" Value="#99A9B7" />
                                        <Setter Property="Background" Value="#121C24" />
                                        <Setter Property="BorderBrush" Value="#31404E" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Setter Property="Padding" Value="4,5" />
                                    </Style>
                                </Border.Resources>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="Research Maturity"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ResearchMaturity.Summary}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding ResearchMaturityProgressLabel}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,7,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ResearchMaturityStateLabel}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ResearchMaturity.State}"
                                                                             Value="{x:Static contracts:ResearchMaturityEvidenceState.Available}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ResearchMaturity.State}"
                                                                             Value="{x:Static contracts:ResearchMaturityEvidenceState.Stale}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ResearchMaturity.State}"
                                                                             Value="{x:Static contracts:ResearchMaturityEvidenceState.Partial}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ResearchMaturity.State}"
                                                                             Value="{x:Static contracts:ResearchMaturityEvidenceState.Unavailable}">
                                                                    <Setter Property="Foreground" Value="#FF7B86" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ResearchMaturityAsOfLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding ResearchMaturity.SourceLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="10"
                                                           Margin="0,2,0,0"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Background="#302B1D"
                                                BorderBrush="{StaticResource Amber}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="10"
                                                Margin="0,12,0,10">
                                            <DockPanel>
                                                <TextBlock Text="STRATEGY OPTIMIZATION LOCKED"
                                                           Foreground="{StaticResource Amber}"
                                                           FontWeight="SemiBold"
                                                           DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding ResearchMaturity.EvidenceGate.AllowedAction, StringFormat=Allowed now: {0}}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                        </Border>

                                        <UniformGrid Columns="4" Margin="0,0,0,10">
                                            <Border Background="#17212B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="Maturity Outcome Coverage" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                    <TextBlock Text="{Binding ResearchMaturityRateLabel}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="Scorable denominator only" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#17212B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="Census Outcome Coverage" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                    <TextBlock Text="{Binding ResearchCensusRateLabel}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="All-alert denominator" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#17212B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="Sample Confidence" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                    <TextBlock Text="{Binding ResearchMaturity.SampleConfidence}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding ResearchMaturity.MeasurableEdgeStatus}" Foreground="{StaticResource Amber}" FontSize="10" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#17212B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Evidence Needed" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                    <TextBlock Text="{Binding ResearchMaturity.EvidenceNeededToNextGate, StringFormat={}{0:N0}}"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="completed alerts to next gate" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <TabControl Background="#17212B"
                                                    Foreground="{StaticResource TextPrimary}"
                                                    MinHeight="260">
                                            <TabItem Header="Evidence Gates">
                                                <DataGrid ItemsSource="{Binding ResearchMaturity.Gates}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          Background="#17212B"
                                                          Foreground="{StaticResource TextPrimary}"
                                                          BorderBrush="{StaticResource PanelBorder}"
                                                          ColumnHeaderStyle="{StaticResource ResearchMaturityColumnHeaderStyle}"
                                                          RowHeaderWidth="0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Gate" Binding="{Binding Name}" Width="260" />
                                                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="110" />
                                                        <DataGridTextColumn Header="Current" Binding="{Binding CurrentCompletedAlerts}" Width="80" />
                                                        <DataGridTextColumn Header="Required" Binding="{Binding RequiredCompletedAlerts}" Width="80" />
                                                        <DataGridTextColumn Header="Needed" Binding="{Binding CompletedNeeded}" Width="80" />
                                                        <DataGridTextColumn Header="Allowed Research Action" Binding="{Binding AllowedAction}" Width="*" MinWidth="260" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </TabItem>
                                            <TabItem Header="Census Counts">
                                                <Grid Margin="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>
                                                    <UniformGrid Columns="2" Margin="0,0,12,0">
                                                        <StackPanel Margin="0,0,8,8">
                                                            <TextBlock Text="Captures" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                            <TextBlock Text="{Binding ResearchMaturity.Census.Captures, StringFormat={}{0:N0}}" FontSize="17" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,8">
                                                            <TextBlock Text="Candidate Rows" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                            <TextBlock Text="{Binding ResearchMaturity.Census.CandidateRows, StringFormat={}{0:N0}}" FontSize="17" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,8">
                                                            <TextBlock Text="Minute Bars" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                            <TextBlock Text="{Binding ResearchMaturity.Census.MinuteBars, StringFormat={}{0:N0}}" FontSize="17" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,8">
                                                            <TextBlock Text="Minute Symbols" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                            <TextBlock Text="{Binding ResearchMaturity.Census.MinuteBarSymbols, StringFormat={}{0:N0}}" FontSize="17" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,8">
                                                            <TextBlock Text="Evidence Runs" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                            <TextBlock Text="{Binding ResearchMaturity.Census.EvidenceRuns, StringFormat={}{0:N0}}" FontSize="17" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,8">
                                                            <TextBlock Text="Evidence Metrics" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                            <TextBlock Text="{Binding ResearchMaturity.Census.EvidenceMetrics, StringFormat={}{0:N0}}" FontSize="17" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,8">
                                                            <TextBlock Text="Entry Plans" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                            <TextBlock Text="{Binding ResearchMaturity.Census.EntryPlans, StringFormat={}{0:N0}}" FontSize="17" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,8">
                                                            <TextBlock Text="Complete Plans" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                            <TextBlock Text="{Binding ResearchMaturity.Census.CompleteEntryPlans, StringFormat={}{0:N0}}" FontSize="17" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <DataGrid Grid.Column="1"
                                                              ItemsSource="{Binding ResearchMaturity.Census.TableCounts}"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              CanUserAddRows="False"
                                                              HeadersVisibility="Column"
                                                              GridLinesVisibility="Horizontal"
                                                              Background="#17212B"
                                                              Foreground="{StaticResource TextPrimary}"
                                                              BorderBrush="{StaticResource PanelBorder}"
                                                              ColumnHeaderStyle="{StaticResource ResearchMaturityColumnHeaderStyle}"
                                                              RowHeaderWidth="0">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Persisted Evidence Table" Binding="{Binding Name}" Width="*" />
                                                            <DataGridTextColumn Header="Rows" Binding="{Binding Count, StringFormat={}{0:N0}}" Width="90" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </TabItem>
                                            <TabItem Header="Research Questions">
                                                <DataGrid ItemsSource="{Binding ResearchMaturity.Questions}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          Background="#17212B"
                                                          Foreground="{StaticResource TextPrimary}"
                                                          BorderBrush="{StaticResource PanelBorder}"
                                                          ColumnHeaderStyle="{StaticResource ResearchMaturityColumnHeaderStyle}"
                                                          RowHeaderWidth="0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Question" Binding="{Binding Question}" Width="1.2*" />
                                                        <DataGridTextColumn Header="Evidence Answer" Binding="{Binding Answer}" Width="2*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </TabItem>
                                        </TabControl>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Expander Header="Warnings" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ResearchMaturityWarningsLabel}"
                                                           Foreground="{StaticResource Amber}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0" />
                                            </Expander>
                                            <Expander Grid.Column="1" Header="Safety Notes">
                                                <TextBlock Text="{Binding ResearchMaturitySafetyLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0" />
