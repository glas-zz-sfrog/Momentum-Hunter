                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding TechnicalResearchOverview.Summary}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding TechnicalResearchOverview.WarningSummary}"
                                                   Foreground="{StaticResource Amber}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2"
                                               Text="Research evidence only. Stored reports are not regenerated here, and no score, readiness, alert, watchlist, plan, or execution behavior changes."
                                               Foreground="{StaticResource Amber}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,8" />
                                    <TabControl x:Name="TechnicalResearchTabs" Grid.Row="3">
                                        <TabItem Header="Signals">
                                            <Grid Background="#17212B">
                                                <ListBox ItemsSource="{Binding TechnicalResearchEventRows}"
