                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>

                    <avalon:LayoutAnchorablePane DockHeight="520" DockMinHeight="260">
