                                                            <DataTrigger Binding="{Binding TechnicalResearchOverview.StateLabel}" Value="AVAILABLE">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TechnicalResearchOverview.StateLabel}" Value="STALE">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TechnicalResearchOverview.StateLabel}" Value="PARTIAL">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TechnicalResearchOverview.StateLabel}" Value="EMPTY">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
