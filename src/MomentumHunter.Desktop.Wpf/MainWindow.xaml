<Window x:Class="MomentumHunter.Desktop.Wpf.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:controls="clr-namespace:MomentumHunter.Desktop.Wpf.Controls"
        Title="Momentum Hunter Workstation"
        Height="900"
        Width="1500"
        MinHeight="650"
        MinWidth="1050"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121C24" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="275" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="185" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MOMENTUM HUNTER" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  WORKSTATION" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Live" Tag="Live" Click="WorkspaceButton_Click" />
                    <Button Content="Replay" Tag="Replay" Click="WorkspaceButton_Click" />
                    <Button Content="Review" Tag="Review" Click="WorkspaceButton_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="1m" Tag="1m" Click="IntervalButton_Click" />
                    <Button Content="5m" Tag="5m" Click="IntervalButton_Click" />
                    <Button Content="15m" Tag="15m" Click="IntervalButton_Click" />
                    <Button Content="Daily" Tag="Daily" Click="IntervalButton_Click" />
                </StackPanel>
                <TextBox Grid.Column="3"
                         Width="300"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Background="#1A2731"
                         BorderBrush="{StaticResource PanelBorder}"
                         Foreground="{StaticResource TextPrimary}"
                         Padding="9,5"
                         Text="Search symbol or command (Ctrl+K)" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="SaveLayoutButton_Click"><TextBlock Text="Save Layout" Foreground="{StaticResource TextPrimary}" /></Button>
                    <Button Click="RestoreLayoutButton_Click"><TextBlock Text="Restore" Foreground="{StaticResource TextPrimary}" /></Button>
                </StackPanel>
                <Border Grid.Column="5" Padding="10,5" Margin="5,0" Background="#203A38" CornerRadius="3">
                    <TextBlock Text="SIMULATION ONLY" Foreground="{StaticResource Teal}" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <Button Grid.Column="6" Content="Activity" Click="ActivityButton_Click" VerticalAlignment="Center" />
                <Button x:Name="HealthButton" Grid.Column="7" Content="Health" Command="{Binding ToggleHealthCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <avalon:DockingManager x:Name="DockManager" Grid.Row="1" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource PanelBorder}">
            <avalon:DockingManager.Theme>
                <themes:Vs2013DarkTheme />
            </avalon:DockingManager.Theme>
            <avalon:LayoutRoot>
                <avalon:LayoutPanel Orientation="Vertical">
                    <avalon:LayoutPanel Orientation="Horizontal">
                        <avalon:LayoutAnchorablePane DockWidth="310">
                            <avalon:LayoutAnchorable Title="Hunter" CanClose="False" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding WorkspaceTitle}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Grid.Row="1" Text="{Binding WorkspaceNarrative}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <DataGrid x:Name="CandidateGrid"
                                                  Grid.Row="2"
                                                  ItemsSource="{Binding Candidates}"
                                                  SelectedItem="{Binding SelectedCandidate, Mode=OneWay}"
                                                  SelectionChanged="CandidateGrid_SelectionChanged"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserResizeRows="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  Background="#17212B"
                                                  Foreground="{StaticResource TextPrimary}"
                                                  BorderBrush="{StaticResource PanelBorder}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="42" />
                                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="58" />
                                                <DataGridTextColumn Header="Last" Binding="{Binding LastPrice, StringFormat={}{0:C2}}" Width="70" />
                                                <DataGridTextColumn Header="RVOL" Binding="{Binding RelativeVolume, StringFormat={}{0:N1}x}" Width="48" />
                                                <DataGridTextColumn Header="Gate" Binding="{Binding OperatorState}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>

                        <avalon:LayoutDocumentPane x:Name="ChartDocumentPane">
                            <avalon:LayoutDocument Title="Chart" CanClose="False">
                                <Border Background="{StaticResource PanelBackground}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding SelectedSymbol}" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="Deterministic mock candle data" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border Padding="7,3" Margin="4,0" Background="#263846" CornerRadius="3">
                                                    <TextBlock Text="{Binding PrimaryChartLinkLabel}" Foreground="{StaticResource Teal}" FontSize="11" />
                                                </Border>
                                                <Button Content="Link" Command="{Binding CyclePrimaryChartLinkGroupCommand}" />
                                                <Button Content="Pin" Command="{Binding TogglePrimaryChartPinCommand}" />
                                                <Button Content="New Chart" Click="NewChartButton_Click" />
                                            </StackPanel>
                                        </DockPanel>
                                        <controls:CandleChart Grid.Row="1" Candles="{Binding Candles}" Margin="0,12,0,8" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <TextBlock Text="Research display only" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            <TextBlock Text="  |  Linked panes update only within their selected link group" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </avalon:LayoutDocument>
                        </avalon:LayoutDocumentPane>

                        <avalon:LayoutAnchorablePane DockWidth="340">
                            <avalon:LayoutAnchorable Title="Trade Plan" CanClose="False" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Trade Plan" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TradePlan.DataLineage.Summary}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" MaxWidth="270" />
                                            </StackPanel>
                                            <Border DockPanel.Dock="Right" Padding="7,3" Background="#3A3524" CornerRadius="3">
                                                <TextBlock Text="{Binding TradePlan.RiskDecision.State}" Foreground="{StaticResource Amber}" FontSize="10" />
                                            </Border>
                                        </DockPanel>
                                        <TabControl Grid.Row="1" Margin="0,12,0,0" Background="#17212B" Foreground="{StaticResource TextPrimary}">
                                            <TabItem Header="Plan">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="8">
                                                        <UniformGrid Columns="2" Margin="0,0,0,12">
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Entry" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.Entry, StringFormat={}{0:C2}}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Stop" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.Stop, StringFormat={}{0:C2}}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Target" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.Target, StringFormat={}{0:C2}}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Reward/Risk" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.RewardToRisk, StringFormat={}{0:N2}}" FontSize="16" /></StackPanel>
                                                        </UniformGrid>
                                                        <TextBlock Text="Readiness Gate" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                        <ItemsControl ItemsSource="{Binding TradePlan.Checks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding TradePlan.RiskDecision.Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                        <Button Content="{Binding TradePlan.PrimaryAction}" Click="TradePlanActionButton_Click" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Why"><TextBlock Text="Research evidence and catalyst context are supplied through the engine boundary." Margin="12" TextWrapping="Wrap" /></TabItem>
                                            <TabItem Header="Research"><TextBlock Text="Technical details are intentionally a disclosure, not a trade recommendation." Margin="12" TextWrapping="Wrap" /></TabItem>
                                            <TabItem Header="History"><TextBlock Text="No order or broker history exists in this simulation-only shell." Margin="12" TextWrapping="Wrap" /></TabItem>
                                        </TabControl>
                                    </Grid>
                                </Border>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>
                    </avalon:LayoutPanel>

                    <avalon:LayoutAnchorablePane DockHeight="180" DockMinHeight="90">
                        <avalon:LayoutAnchorable x:Name="ActivityAnchor" Title="Activity" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                    <ListBox ItemsSource="{Binding Activity}" Background="#17212B" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Foreground="{StaticResource TextMuted}" Width="52" />
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource Teal}" Width="84" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Activity is local to this shell." FontWeight="SemiBold" />
                                        <TextBlock Text="Recent workspace and evidence events appear here; reopen it any time from the top bar." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <Button Content="Diagnostics" Click="DiagnosticsButton_Click" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="DiagnosticsAnchor" Title="Diagnostics" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Health detail and raw diagnostic names are intentionally separate from the everyday workflow." Foreground="{StaticResource TextMuted}" Margin="0,4,0,10" />
                                    <ItemsControl ItemsSource="{Binding Health.Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Margin="0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>
                </avalon:LayoutPanel>
            </avalon:LayoutRoot>
        </avalon:DockingManager>

        <Border Grid.Row="2" Background="#121C24" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding WorkspaceNarrative}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" FontSize="10" />
            </DockPanel>
        </Border>

        <Popup IsOpen="{Binding IsHealthOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=HealthButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="340" Padding="14" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="System Health" FontSize="15" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Health.Components}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding State}" Foreground="{StaticResource Amber}" DockPanel.Dock="Right" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Open Diagnostics" Click="DiagnosticsButton_Click" Margin="0,10,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup IsOpen="{Binding IsCommandPaletteOpen}" Placement="Center" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="480" Padding="16" Background="#1B2731" BorderBrush="{StaticResource Teal}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Command Palette" FontSize="16" FontWeight="SemiBold" />
                    <TextBox Margin="0,10,0,8" Background="#10161D" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}" Padding="8" Text="Type a symbol or command" />
                    <TextBlock Text="Open candidate   |   Add chart   |   Toggle activity   |   View diagnostics" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
