                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SavedWatchlist.State}" Value="{x:Static contracts:SavedWatchlistState.Stale}">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SavedWatchlist.State}" Value="{x:Static contracts:SavedWatchlistState.Partial}">
