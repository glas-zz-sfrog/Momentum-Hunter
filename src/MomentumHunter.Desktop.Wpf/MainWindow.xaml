<Window x:Class="MomentumHunter.Desktop.Wpf.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:controls="clr-namespace:MomentumHunter.Desktop.Wpf.Controls"
        Title="Momentum Hunter Workstation"
        Height="920"
        Width="1440"
        MinHeight="650"
        MinWidth="1050"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ShadowFilterComboStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#1A2731" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid MinHeight="27">
                            <ToggleButton Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <Grid IsHitTestVisible="False" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="▼" Foreground="{StaticResource TextMuted}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#1A2731"
                                        BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121C24" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="185" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="MOMENTUM HUNTER" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  WORKSTATION" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Live" Tag="Live" Click="WorkspaceButton_Click" />
                    <Button Content="Replay" Tag="Replay" Click="WorkspaceButton_Click" />
                    <Button Content="Review" Tag="Review" Click="WorkspaceButton_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="1m" Tag="1m" Click="IntervalButton_Click" />
                    <Button Content="5m" Tag="5m" Click="IntervalButton_Click" />
                    <Button Content="15m" Tag="15m" Click="IntervalButton_Click" />
                    <Button Content="Daily" Tag="Daily" Click="IntervalButton_Click" />
                </StackPanel>
                <TextBox Grid.Column="3"
                         Width="300"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Background="#1A2731"
                         BorderBrush="{StaticResource PanelBorder}"
                         Foreground="{StaticResource TextPrimary}"
                         Padding="9,5"
                         Text="Search symbol or command (Ctrl+K)" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="SaveLayoutButton_Click"><TextBlock Text="Save Layout" Foreground="{StaticResource TextPrimary}" /></Button>
                    <Button Click="RestoreLayoutButton_Click"><TextBlock Text="Restore" Foreground="{StaticResource TextPrimary}" /></Button>
                <Button x:Name="PanesButton" Content="Panes" Click="PanesButton_Click" />
                </StackPanel>
                <Border Grid.Column="5" Padding="10,5" Margin="5,0" Background="#253440" CornerRadius="3">
                    <TextBlock Text="{Binding BackgroundStatusLabel}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <Border Grid.Column="6" Padding="10,5" Margin="5,0" Background="#203A38" CornerRadius="3">
                    <TextBlock Text="{Binding EnvironmentLabel}" Foreground="{StaticResource Teal}" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <Button Grid.Column="7" Content="{Binding ActivityLabel}" Click="ActivityButton_Click" VerticalAlignment="Center" />
                <Button x:Name="HealthButton" Grid.Column="8" Content="Health" Command="{Binding ToggleHealthCommand}" VerticalAlignment="Center" />
                <Button x:Name="ApplicationMenuButton" Grid.Column="9" Content="Menu" Click="ApplicationMenuButton_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <avalon:DockingManager x:Name="DockManager" Grid.Row="1" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource PanelBorder}">
            <avalon:DockingManager.Theme>
                <themes:Vs2013DarkTheme />
            </avalon:DockingManager.Theme>
            <avalon:LayoutRoot>
                <avalon:LayoutPanel Orientation="Vertical">
                    <avalon:LayoutPanel Orientation="Horizontal">
                        <avalon:LayoutAnchorablePane DockWidth="310">
                            <avalon:LayoutAnchorable x:Name="HunterAnchor" ContentId="pane-hunter" Title="Hunter" CanClose="True" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding WorkspaceTitle}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Grid.Row="1" Text="{Binding WorkspaceNarrative}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <ListBox x:Name="CandidateGrid"
                                                 Grid.Row="2"
                                                 ItemsSource="{Binding Candidates}"
                                                 SelectedItem="{Binding SelectedCandidate, Mode=OneWay}"
                                                 SelectionChanged="CandidateGrid_SelectionChanged"
                                                 Background="#17212B"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 BorderBrush="{StaticResource PanelBorder}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="5,5,5,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Row="0" Grid.Column="0" Content="{Binding Score}" Tag="{Binding}" Click="CandidateScoreButton_Click" Padding="2" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Symbol}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LastPrice, StringFormat={}{0:C2}}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ChangePercent, StringFormat={}{0:+0.0;-0.0;0.0}%}" Foreground="{StaticResource Teal}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="2,4,4,0" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding RelativeVolume, StringFormat=RVOL {0:N1}x}" />
                                                            <Run Text=" | " />
                                                            <Run Text="{Binding FloatOrLiquidity}" />
                                                            <Run Text=" | " />
                                                            <Run Text="{Binding Catalyst}" />
                                                        </TextBlock>
                                                        <Border Grid.Row="1" Grid.Column="3" Background="#263846" CornerRadius="3" Padding="5,2" Margin="4,4,0,0" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding OperatorState}" Foreground="{StaticResource Teal}" FontSize="10" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>

                        <avalon:LayoutDocumentPane x:Name="ChartDocumentPane">
                            <avalon:LayoutDocument x:Name="PrimaryChartDocument" ContentId="pane-primary-chart" Title="Chart" CanClose="False" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border Padding="7,3" Margin="4,0" Background="#263846" CornerRadius="3">
                                                    <TextBlock Text="{Binding PrimaryChartLinkLabel}" Foreground="{StaticResource Teal}" FontSize="11" />
                                                </Border>
                                                <Button Content="Link" Command="{Binding CyclePrimaryChartLinkGroupCommand}" />
                                                <Button Content="Pin" Command="{Binding TogglePrimaryChartPinCommand}" />
                                                <Button Content="New Chart" Click="NewChartButton_Click" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding PrimaryChart.Pane.Symbol}" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ChartSourceLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ChartSourceLabel}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <controls:CandleChart Grid.Row="1"
                                                              Candles="{Binding PrimaryChart.Candles}"
                                                              EmptyStateText="{Binding PrimaryChart.EmptyStateText}"
                                                              Interval="{Binding PrimaryChart.Pane.Interval}"
                                                              Margin="0,12,0,8" />
                                        <Border Grid.Row="2"
                                                BorderBrush="{StaticResource PanelBorder}"
                                                BorderThickness="0,1,0,0"
                                                Padding="0,7,0,6">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="LATEST BAR"
                                                           Foreground="{StaticResource Teal}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding PrimaryChart.LatestBarSummary}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding PrimaryChart.LatestBarSummary}" />
                                            </DockPanel>
                                        </Border>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                                            <TextBlock Text="Research display only" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            <TextBlock Text="  |  Linked panes update only within their selected link group" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </avalon:LayoutDocument>
                        </avalon:LayoutDocumentPane>

                        <avalon:LayoutAnchorablePane DockWidth="340">
                            <avalon:LayoutAnchorable x:Name="TradePlanAnchor" ContentId="pane-trade-plan" Title="Trade Plan" CanClose="True" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Trade Plan" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TradePlanSymbolLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Border Padding="7,3" Margin="0,0,4,0" Background="#263846" CornerRadius="3">
                                                    <TextBlock Text="{Binding PrimaryTradePlanLinkLabel}" Foreground="{StaticResource Teal}" FontSize="10" />
                                                </Border>
                                                <Border Padding="7,3" Margin="0,0,4,0" Background="#3A3524" CornerRadius="3">
                                                    <TextBlock Text="{Binding TradePlanRiskStatusLabel}" Foreground="{StaticResource Amber}" FontSize="10" />
                                                </Border>
                                                <Button Content="Pin" Command="{Binding TogglePrimaryTradePlanPinCommand}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding PlanningStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,2" />
                                        <TabControl Grid.Row="2" Margin="0,12,0,0" Background="#17212B" Foreground="{StaticResource TextPrimary}" SelectedIndex="{Binding TradePlanTabIndex}">
                                            <TabItem Header="Plan">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="8">
                                                        <UniformGrid Columns="2" Margin="0,0,0,12">
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Entry" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.EntryDisplay}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Stop" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.StopDisplay}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Target" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.TargetDisplay}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Reward/Risk" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.RewardToRiskDisplay}" FontSize="16" /></StackPanel>
                                                        </UniformGrid>
                                                        <TextBlock Text="Readiness Gate" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                        <ItemsControl ItemsSource="{Binding TradePlan.Checks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding TradePlan.RiskDecision.Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                        <Button Content="{Binding PrimaryActionLabel}" IsEnabled="{Binding CanRunPrimaryAction}" Click="TradePlanActionButton_Click" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Why">
                                                <StackPanel Margin="12">
                                                    <TextBlock Text="Frozen decision context" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SelectedShadowTrade.Setup, StringFormat=Setup: {0}}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedShadowTrade.Catalyst, StringFormat=Catalyst: {0}}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedShadowTrade.Identity.MarketRegime, StringFormat=Market regime: {0}}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.ReasonDisplay}" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="Research"><TextBlock Text="Technical details are intentionally a disclosure, not a trade recommendation." Margin="12" TextWrapping="Wrap" /></TabItem>
                                            <TabItem Header="History">
                                                <StackPanel Margin="12">
                                                    <TextBlock Text="Prospective FakeBroker history" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SelectedShadowTrade.Execution.LifecycleState, StringFormat=Lifecycle: {0}}" Margin="0,8,0,0" />
                                                    <TextBlock Text="{Binding SelectedShadowTrade.Execution.LastReason}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SelectedShadowTrade.Execution.Quality.Summary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </Border>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>
                    </avalon:LayoutPanel>

                    <avalon:LayoutAnchorablePane DockHeight="420" DockMinHeight="90">
                        <avalon:LayoutAnchorable x:Name="ActivityAnchor" ContentId="pane-activity" Title="Activity" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                    <ListBox ItemsSource="{Binding Activity}" Background="#17212B" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Foreground="{StaticResource TextMuted}" Width="52" />
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource Teal}" Width="84" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ActivitySourceLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="Recent workspace and evidence events appear here; reopen it any time from the top bar." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <Button Content="Diagnostics" Click="DiagnosticsButton_Click" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="DiagnosticsAnchor" ContentId="pane-diagnostics" Title="Diagnostics" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Health detail and raw diagnostic names are intentionally separate from the everyday workflow." Foreground="{StaticResource TextMuted}" Margin="0,4,0,10" />
                                    <ItemsControl ItemsSource="{Binding Health.Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Margin="0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="ResearchAnchor" ContentId="pane-research" Title="Research" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Research" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ResearchSummary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Text="Catalyst and lineage are shown in the Trade Plan tabs. Detailed provider mechanics remain in Diagnostics." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="WatchlistAnchor" ContentId="pane-watchlist" Title="Watchlist" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Watchlist" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Saved symbol collections are an optional workspace pane in this shell spike." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Text="Use the Hunter pane for the active ranked candidate list." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="AutomationAnchor" ContentId="pane-automation" Title="Automation" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Automation" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Automation status and scheduled research work appear here when that capability is added." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Text="This shell exposes no automatic trading controls." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="OrdersAnchor" ContentId="pane-orders" Title="Orders" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Orders" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Order activity is unavailable in this simulation-only workstation shell." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Text="The shell does not send, cancel, or modify orders." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="PositionsAnchor" ContentId="pane-positions" Title="Positions" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Positions" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Position data is unavailable because no account data source is configured." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Text="A future read-only account source can appear here after explicit approval." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="ReplayEventsAnchor" ContentId="pane-replay-events" Title="Replay Events" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Replay Events" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Historical decisions are read-only and cannot alter current research." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Text="{Binding ReplaySummary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="ShadowReviewAnchor" ContentId="pane-shadow-review" Title="Shadow Review" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Padding="8,4" Background="#203A38" CornerRadius="3">
                                            <TextBlock Text="FAKEBROKER • NONTRANSMITTING" Foreground="{StaticResource Teal}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Shadow Review" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ShadowReviewStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <WrapPanel Grid.Row="1" Margin="0,10,0,8">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Date / session" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <ComboBox Width="160" Style="{StaticResource ShadowFilterComboStyle}" ItemsSource="{Binding ShadowDateSessionOptions}" SelectedItem="{Binding ShadowDateSessionFilter}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Setup" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <ComboBox Width="145" Style="{StaticResource ShadowFilterComboStyle}" ItemsSource="{Binding ShadowSetupOptions}" SelectedItem="{Binding ShadowSetupFilter}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Catalyst" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <ComboBox Width="165" Style="{StaticResource ShadowFilterComboStyle}" ItemsSource="{Binding ShadowCatalystOptions}" SelectedItem="{Binding ShadowCatalystFilter}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Market regime" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <ComboBox Width="140" Style="{StaticResource ShadowFilterComboStyle}" ItemsSource="{Binding ShadowRegimeOptions}" SelectedItem="{Binding ShadowRegimeFilter}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Outcome" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <ComboBox Width="125" Style="{StaticResource ShadowFilterComboStyle}" ItemsSource="{Binding ShadowOutcomeOptions}" SelectedItem="{Binding ShadowOutcomeFilter}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Evidence eligibility" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <ComboBox Width="135" Style="{StaticResource ShadowFilterComboStyle}" ItemsSource="{Binding ShadowEligibilityOptions}" SelectedItem="{Binding ShadowEligibilityFilter}" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <Grid Grid.Row="2" Background="#121C24" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="8,6">
                                            <TextBlock Text="{Binding ShadowSample.ProgressLabel}" Foreground="{StaticResource Teal}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ShadowSample.Status}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,6"><TextBlock Text="COMPLETED" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowSample.Completed}" FontSize="15" /></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,6"><TextBlock Text="ACTIVE" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowSample.Active}" FontSize="15" /></StackPanel>
                                        <StackPanel Grid.Column="3" Margin="8,6"><TextBlock Text="UNFILLED" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowSample.Unfilled}" FontSize="15" /></StackPanel>
                                        <StackPanel Grid.Column="4" Margin="8,6"><TextBlock Text="RISK REJECTED" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowSample.RiskRejected}" FontSize="15" /></StackPanel>
                                        <StackPanel Grid.Column="5" Margin="8,6"><TextBlock Text="DATA INVALID" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowSample.DataQualityInvalidated}" FontSize="15" /></StackPanel>
                                        <StackPanel Grid.Column="6" Margin="8,6"><TextBlock Text="EXCLUDED" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowSample.Excluded}" FontSize="15" /></StackPanel>
                                    </Grid>

                                    <UniformGrid Grid.Row="3" Columns="8" Margin="0,0,0,8">
                                        <StackPanel Margin="5,2"><TextBlock Text="WIN RATE" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowMetrics.WinRateDisplay}" /></StackPanel>
                                        <StackPanel Margin="5,2"><TextBlock Text="AVG WIN" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowMetrics.AverageWinDisplay}" /></StackPanel>
                                        <StackPanel Margin="5,2"><TextBlock Text="AVG LOSS" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowMetrics.AverageLossDisplay}" /></StackPanel>
                                        <StackPanel Margin="5,2"><TextBlock Text="EXPECTANCY" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowMetrics.ExpectancyDisplay}" /></StackPanel>
                                        <StackPanel Margin="5,2"><TextBlock Text="AVG R" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowMetrics.AverageRDisplay}" /></StackPanel>
                                        <StackPanel Margin="5,2"><TextBlock Text="MAX DRAWDOWN" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowMetrics.MaximumDrawdownDisplay}" /></StackPanel>
                                        <StackPanel Margin="5,2"><TextBlock Text="PROFIT FACTOR" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowMetrics.ProfitFactorDisplay}" /></StackPanel>
                                        <StackPanel Margin="5,2"><TextBlock Text="IDEAL / EXEC GAP" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding ShadowMetrics.PerformanceGapDisplay}" /></StackPanel>
                                    </UniformGrid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="7*" />
                                        </Grid.ColumnDefinitions>
                                        <DataGrid x:Name="ShadowTradesGrid"
                                                  ItemsSource="{Binding ShadowTrades}"
                                                  SelectedItem="{Binding SelectedShadowTrade, Mode=OneWay}"
                                                  SelectionChanged="ShadowTradesGrid_SelectionChanged"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  SelectionMode="Single"
                                                  HeadersVisibility="Column"
                                                  Background="#17212B"
                                                  BorderBrush="{StaticResource PanelBorder}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="70" />
                                                <DataGridTextColumn Header="Setup" Binding="{Binding Setup}" Width="120" />
                                                <DataGridTextColumn Header="Decision" Binding="{Binding DecisionTimestamp, StringFormat={}{0:MM-dd HH:mm}}" Width="105" />
                                                <DataGridTextColumn Header="Lifecycle" Binding="{Binding LifecycleState}" Width="110" />
                                                <DataGridTextColumn Header="Outcome" Binding="{Binding OutcomeLabel}" Width="90" />
                                                <DataGridTextColumn Header="Evidence" Binding="{Binding EligibilityLabel}" Width="90" />
                                                <DataGridTextColumn Header="Shadow Trade ID" Binding="{Binding ShadowTradeId}" Width="180" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TabControl Grid.Column="1" Margin="10,0,0,0" Background="#17212B">
                                            <TabItem Header="Overview">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <Grid Margin="10">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="4" Margin="3,0,3,6">
                                                            <WrapPanel>
                                                                <Border Background="#203A38" Padding="7,3" Margin="0,0,5,3" CornerRadius="3"><TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.EvidenceFrozenLabel}" Foreground="{StaticResource Teal}" FontSize="10" /></Border>
                                                                <Border Background="#203A38" Padding="7,3" Margin="0,0,5,3" CornerRadius="3"><TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.PlanFrozenLabel}" Foreground="{StaticResource Teal}" FontSize="10" /></Border>
                                                                <Border Background="#253440" Padding="7,3" Margin="0,0,5,3" CornerRadius="3"><TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.CorrectionLabel}" FontSize="10" /></Border>
                                                            </WrapPanel>
                                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10">
                                                                <Run Text="{Binding SelectedShadowTrade.Identity.DecisionTimestamp, StringFormat=Decision {0:yyyy-MM-dd HH:mm:ss zzz}}" />
                                                                <Run Text="  |  " />
                                                                <Run Text="{Binding SelectedShadowTrade.Identity.EvidenceSnapshotTimestamp, StringFormat=Evidence {0:yyyy-MM-dd HH:mm:ss zzz}}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="3"><TextBlock Text="SHADOW TRADE ID" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Identity.ShadowTradeId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedShadowTrade.Identity.ShadowTradeId}" /></StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="3"><TextBlock Text="TRADEPLAN ID" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Identity.TradePlanId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedShadowTrade.Identity.TradePlanId}" /></StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="3"><TextBlock Text="RISK DECISION" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Plan.RiskDecision}" /></StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="3"><TextBlock Text="LIFECYCLE" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Execution.LifecycleState}" /></StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="3"><TextBlock Text="PROPOSED ENTRY" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Plan.ProposedEntryDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="3"><TextBlock Text="SIMULATED FILL" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Execution.SimulatedFillDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="3"><TextBlock Text="SPREAD" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Execution.SpreadDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="3"><TextBlock Text="SLIPPAGE" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Execution.SlippageDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="3"><TextBlock Text="STOP" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Plan.StopDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="3"><TextBlock Text="TARGETS" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Plan.TargetsDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="3"><TextBlock Text="EXIT" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Execution.ExitDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="3" Grid.Column="3" Margin="3"><TextBlock Text="EXIT REASON" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Execution.ExitReason}" /></StackPanel>
                                                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="3"><TextBlock Text="IDEAL P&amp;L" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Outcome.IdealPnlDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="3"><TextBlock Text="EXECUTABLE P&amp;L" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Outcome.ExecutablePnlDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="3"><TextBlock Text="R MULTIPLE" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Outcome.RMultipleDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="4" Grid.Column="3" Margin="3"><TextBlock Text="DURATION" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Outcome.DurationDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="3"><TextBlock Text="MFE" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Outcome.MfeDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="3"><TextBlock Text="MAE" Foreground="{StaticResource TextMuted}" FontSize="9" /><TextBlock Text="{Binding SelectedShadowTrade.Outcome.MaeDisplay}" /></StackPanel>
                                                        <StackPanel Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Margin="3">
                                                            <TextBlock Text="EXECUTION QUALITY" Foreground="{StaticResource TextMuted}" FontSize="9" />
                                                            <TextBlock Text="{Binding SelectedShadowTrade.Execution.Quality.Summary}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Evidence Lock">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="10">
                                                        <WrapPanel>
                                                            <Border Background="#203A38" Padding="8,4" Margin="0,0,6,6" CornerRadius="3"><TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.EvidenceFrozenLabel}" Foreground="{StaticResource Teal}" /></Border>
                                                            <Border Background="#203A38" Padding="8,4" Margin="0,0,6,6" CornerRadius="3"><TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.PlanFrozenLabel}" Foreground="{StaticResource Teal}" /></Border>
                                                            <Border Background="#253440" Padding="8,4" Margin="0,0,6,6" CornerRadius="3"><TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.CorrectionLabel}" /></Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding SelectedShadowTrade.Identity.DecisionTimestamp, StringFormat=Decision: {0:yyyy-MM-dd HH:mm:ss zzz}}" Margin="0,6,0,0" />
                                                        <TextBlock Text="{Binding SelectedShadowTrade.Identity.EvidenceSnapshotTimestamp, StringFormat=Evidence snapshot: {0:yyyy-MM-dd HH:mm:ss zzz}}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.AuditStatus, StringFormat=Audit: {0}}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding SelectedShadowTrade.DataQualityState, StringFormat=Data quality: {0}}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding SelectedShadowTrade.EvidenceLock.ReasonDisplay}" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Execution Quality">
                                                <Grid Margin="10">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1*" /></Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding SelectedShadowTrade.Execution.Quality.FactorDisplay}" TextWrapping="Wrap" />
                                                    <DataGrid Grid.Row="1" Margin="0,10,0,0"
                                                              ItemsSource="{Binding SelectedShadowTrade.Execution.Quality.TechnicalCodes}"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              CanUserAddRows="False"
                                                              Background="#17212B">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="80" />
                                                            <DataGridTextColumn Header="Code" Binding="{Binding EventType}" Width="150" />
                                                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                                                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="ReviewOutcomesAnchor" ContentId="pane-review-outcomes" Title="Outcomes" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Outcomes" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Insufficient local sample: outcome analytics are intentionally withheld rather than implied." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Text="Use this pane for future outcome and discipline review once a suitable evidence sample exists." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>
                </avalon:LayoutPanel>
            </avalon:LayoutRoot>
        </avalon:DockingManager>

        <Border Grid.Row="2" Background="#121C24" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding WorkspaceNarrative}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundStatusDetail}" Foreground="{StaticResource TextMuted}" FontSize="10" />
            </DockPanel>
        </Border>

        <Popup IsOpen="{Binding IsHealthOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=HealthButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="340" Padding="14" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="System Health" FontSize="15" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Health.Components}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding State}" Foreground="{StaticResource Amber}" DockPanel.Dock="Right" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Open Diagnostics" Click="DiagnosticsButton_Click" Margin="0,10,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="PanesPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=PanesButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="360" Padding="12" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Workspace Panes" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Close hides a pane. Remove permanently deletes that pane instance from this workspace." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <ItemsControl ItemsSource="{Binding Registry.Panes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Symbol}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Open" Tag="{Binding InstanceId}" Click="ReopenPaneButton_Click" />
                                        <Button Content="Remove" Tag="{Binding InstanceId}" Click="RemovePaneButton_Click" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ApplicationMenuPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=ApplicationMenuButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="300" Padding="12" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Background Collection" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BackgroundStatusDetail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <Button Content="{Binding MonitoringToggleLabel}" Click="PauseOrResumeButton_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Run Scan Now" Click="RunScanNowButton_Click" HorizontalAlignment="Stretch" Margin="3,5,3,0" />
                    <Button Content="View System Status" Click="ViewSystemStatusButton_Click" HorizontalAlignment="Stretch" Margin="3,5,3,0" />
                    <Separator Margin="3,10" />
                    <Button Content="Exit Momentum Hunter" Click="ExitApplicationButton_Click" HorizontalAlignment="Stretch" Margin="3,0" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup IsOpen="{Binding IsCommandPaletteOpen}" Placement="Center" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="480" Padding="16" Background="#1B2731" BorderBrush="{StaticResource Teal}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Command Palette" FontSize="16" FontWeight="SemiBold" />
                    <TextBox Margin="0,10,0,8" Background="#10161D" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}" Padding="8" Text="Type a symbol or command" />
                    <TextBlock Text="Open candidate   |   Add chart   |   Toggle activity   |   View diagnostics" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
