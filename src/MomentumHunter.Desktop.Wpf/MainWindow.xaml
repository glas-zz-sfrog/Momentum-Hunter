<Window x:Class="MomentumHunter.Desktop.Wpf.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:controls="clr-namespace:MomentumHunter.Desktop.Wpf.Controls"
        xmlns:contracts="clr-namespace:MomentumHunter.Contracts;assembly=MomentumHunter.Contracts"
        Title="Momentum Hunter Workstation"
        Height="920"
        Width="1440"
        MinHeight="650"
        MinWidth="1050"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121C24" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="185" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="MOMENTUM HUNTER" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  WORKSTATION" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Live" Tag="Live" Click="WorkspaceButton_Click" />
                    <Button Content="Replay" Tag="Replay" Click="WorkspaceButton_Click" />
                    <Button Content="Review" Tag="Review" Click="WorkspaceButton_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="1m" Tag="1m" Click="IntervalButton_Click" />
                    <Button Content="5m" Tag="5m" Click="IntervalButton_Click" />
                    <Button Content="15m" Tag="15m" Click="IntervalButton_Click" />
                    <Button Content="Daily" Tag="Daily" Click="IntervalButton_Click" />
                </StackPanel>
                <Grid Grid.Column="3"
                      MinWidth="120"
                      MaxWidth="360"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
                    <TextBox x:Name="GlobalSearchBox"
                             Background="#1A2731"
                             BorderBrush="{StaticResource PanelBorder}"
                             Foreground="{StaticResource TextPrimary}"
                             Padding="9,5"
                             Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="GlobalSearchBox_PreviewKeyDown" />
                    <TextBlock Text="Search (Ctrl+K)"
                               Foreground="{StaticResource TextMuted}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="32"
                            ToolTip="Save layout"
                            AutomationProperties.Name="Save layout"
                            Click="SaveLayoutButton_Click">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextPrimary}" />
                    </Button>
                    <Button Width="32"
                            ToolTip="Restore layout"
                            AutomationProperties.Name="Restore layout"
                            Click="RestoreLayoutButton_Click">
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextPrimary}" />
                    </Button>
                    <Button x:Name="PanesButton" Content="Panes" Click="PanesButton_Click" />
                </StackPanel>
                <Border Grid.Column="5" Padding="10,5" Margin="5,0" Background="#253440" CornerRadius="3">
                    <TextBlock Text="{Binding BackgroundStatusLabel}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <Border Grid.Column="6" Padding="10,5" Margin="5,0" Background="#203A38" CornerRadius="3">
                    <TextBlock Text="{Binding EnvironmentLabel}" Foreground="{StaticResource Teal}" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <Button Grid.Column="7" Content="{Binding ActivityLabel}" Click="ActivityButton_Click" VerticalAlignment="Center" />
                <Button x:Name="HealthButton" Grid.Column="8" Content="Health" Command="{Binding ToggleHealthCommand}" VerticalAlignment="Center" />
                <Button x:Name="ApplicationMenuButton" Grid.Column="9" Content="Menu" Click="ApplicationMenuButton_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <avalon:DockingManager x:Name="DockManager" Grid.Row="1" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource PanelBorder}">
            <avalon:DockingManager.Theme>
                <themes:Vs2013DarkTheme />
            </avalon:DockingManager.Theme>
            <avalon:LayoutRoot>
                <avalon:LayoutPanel Orientation="Vertical">
                    <avalon:LayoutPanel Orientation="Horizontal">
                        <avalon:LayoutAnchorablePane DockWidth="310">
                            <avalon:LayoutAnchorable x:Name="HunterAnchor" ContentId="pane-hunter" Title="Hunter" CanClose="True" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding WorkspaceTitle}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Grid.Row="1" Text="{Binding WorkspaceNarrative}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <ListBox x:Name="CandidateGrid"
                                                 Grid.Row="2"
                                                 ItemsSource="{Binding Candidates}"
                                                 SelectedItem="{Binding SelectedCandidate, Mode=OneWay}"
                                                 SelectionChanged="CandidateGrid_SelectionChanged"
                                                 Background="#17212B"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 BorderBrush="{StaticResource PanelBorder}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="5,5,5,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Row="0" Grid.Column="0" Content="{Binding Score}" Tag="{Binding}" Click="CandidateScoreButton_Click" Padding="2" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Symbol}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LastPrice, StringFormat={}{0:C2}}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ChangePercent, StringFormat={}{0:+0.0;-0.0;0.0}%}" Foreground="{StaticResource Teal}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="2,4,4,0" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding RelativeVolume, StringFormat=RVOL {0:N1}x}" />
                                                            <Run Text=" | " />
                                                            <Run Text="{Binding FloatOrLiquidity}" />
                                                            <Run Text=" | " />
                                                            <Run Text="{Binding Catalyst}" />
                                                        </TextBlock>
                                                        <Border Grid.Row="1" Grid.Column="3" Background="#263846" CornerRadius="3" Padding="5,2" Margin="4,4,0,0" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding OperatorState}" Foreground="{StaticResource Teal}" FontSize="10" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>

                        <avalon:LayoutDocumentPane x:Name="ChartDocumentPane">
                            <avalon:LayoutDocument x:Name="PrimaryChartDocument" ContentId="pane-primary-chart" Title="Chart" CanClose="False" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border Padding="7,3" Margin="4,0" Background="#263846" CornerRadius="3">
                                                    <TextBlock Text="{Binding PrimaryChartLinkLabel}" Foreground="{StaticResource Teal}" FontSize="11" />
                                                </Border>
                                                <Button Content="Link" Command="{Binding CyclePrimaryChartLinkGroupCommand}" />
                                                <Button Content="Pin" Command="{Binding TogglePrimaryChartPinCommand}" />
                                                <Button Content="New Chart" Click="NewChartButton_Click" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding PrimaryChart.Pane.Symbol}" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ChartSourceLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ChartSourceLabel}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <controls:CandleChart Grid.Row="1"
                                                              Candles="{Binding PrimaryChart.Candles}"
                                                              EmptyStateText="{Binding PrimaryChart.EmptyStateText}"
                                                              Interval="{Binding PrimaryChart.Pane.Interval}"
                                                              InspectedCandle="{Binding PrimaryChart.InspectedBar, Mode=TwoWay}"
                                                              Margin="0,12,0,8" />
                                        <Border Grid.Row="2"
                                                BorderBrush="{StaticResource PanelBorder}"
                                                BorderThickness="0,1,0,0"
                                                Padding="0,7,0,6">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding PrimaryChart.ActiveBarLabel}"
                                                           Foreground="{StaticResource Teal}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding PrimaryChart.ActiveBarSummary}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding PrimaryChart.ActiveBarSummary}" />
                                            </DockPanel>
                                        </Border>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                                            <TextBlock Text="Research display only" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            <TextBlock Text="  |  Linked panes update only within their selected link group" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </avalon:LayoutDocument>
                        </avalon:LayoutDocumentPane>

                        <avalon:LayoutAnchorablePane DockWidth="340">
                            <avalon:LayoutAnchorable x:Name="TradePlanAnchor" ContentId="pane-trade-plan" Title="Trade Plan" CanClose="True" CanFloat="True">
                                <Border Background="{StaticResource PanelBackground}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Trade Plan" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TradePlanSymbolLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Border Padding="7,3" Margin="0,0,4,0" Background="#263846" CornerRadius="3">
                                                    <TextBlock Text="{Binding PrimaryTradePlanLinkLabel}" Foreground="{StaticResource Teal}" FontSize="10" />
                                                </Border>
                                                <Border Padding="7,3" Margin="0,0,4,0" Background="#3A3524" CornerRadius="3">
                                                    <TextBlock Text="{Binding TradePlanRiskStatusLabel}" Foreground="{StaticResource Amber}" FontSize="10" />
                                                </Border>
                                                <Button Content="Pin" Command="{Binding TogglePrimaryTradePlanPinCommand}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding PlanningStatus}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,2" />
                                        <TabControl Grid.Row="2" Margin="0,12,0,0" Background="#17212B" Foreground="{StaticResource TextPrimary}" SelectedIndex="{Binding TradePlanTabIndex}">
                                            <TabItem Header="Plan">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="8">
                                                        <UniformGrid Columns="2" Margin="0,0,0,12">
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Entry" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.EntryDisplay}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Stop" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.StopDisplay}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Target" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.TargetDisplay}" FontSize="16" /></StackPanel>
                                                            <StackPanel Margin="0,0,6,8"><TextBlock Text="Reward/Risk" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock Text="{Binding TradePlan.RewardToRiskDisplay}" FontSize="16" /></StackPanel>
                                                        </UniformGrid>
                                                        <TextBlock Text="Readiness Gate" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                        <ItemsControl ItemsSource="{Binding TradePlan.Checks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding TradePlan.RiskDecision.Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                        <Button Content="{Binding PrimaryActionLabel}" IsEnabled="{Binding CanRunPrimaryAction}" Click="TradePlanActionButton_Click" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Why">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="12">
                                                        <TextBlock Text="{Binding CandidateEvidenceSymbolLabel}" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock Text="Persisted catalyst" Foreground="{StaticResource Teal}" FontSize="11" Margin="0,12,0,3" />
                                                        <TextBlock Text="{Binding CandidateCatalystHeadline}" TextWrapping="Wrap" FontSize="13" />
                                                        <TextBlock Text="{Binding CandidateCatalystSourceLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,5,0,0" />
                                                        <TextBlock Text="{Binding CandidateCatalystObservedAtLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                        <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,10" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="92" />
                                                                <ColumnDefinition Width="1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source state" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,8,7" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CandidateReadinessLabel}" TextWrapping="Wrap" Margin="0,0,0,7" />
                                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Liquidity" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CandidateLiquidityLabel}" TextWrapping="Wrap" />
                                                        </Grid>
                                                        <TextBlock Text="Persisted evidence disclosure only; this is not a trade recommendation." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="Research">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Margin="12">
                                                        <TextBlock Text="Evidence quality" Foreground="{StaticResource Teal}" FontSize="11" />
                                                        <TextBlock Text="{Binding CandidateQualityLabel}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        <TextBlock Text="Source lineage" Foreground="{StaticResource Teal}" FontSize="11" Margin="0,14,0,3" />
                                                        <TextBlock Text="{Binding CandidateLineageSourceLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding CandidateLineageAsOfLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                                        <TextBlock Text="{Binding CandidateLineageSummary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                        <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,10" />
                                                        <TextBlock Text="Opportunity notes" Foreground="{StaticResource Teal}" FontSize="11" />
                                                        <TextBlock Text="{Binding CandidateOpportunityNotesLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,5" />
                                                        <ItemsControl ItemsSource="{Binding CandidateOpportunityNotes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,5">
                                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="Read-only research evidence. No score, readiness, alert, or execution rule is recalculated here." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0" />
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>
                                            <TabItem Header="History"><TextBlock Text="No order or broker history exists in this simulation-only shell." Margin="12" TextWrapping="Wrap" /></TabItem>
                                        </TabControl>
                                    </Grid>
                                </Border>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>
                    </avalon:LayoutPanel>

                    <avalon:LayoutAnchorablePane DockHeight="520" DockMinHeight="300">
                        <avalon:LayoutAnchorable x:Name="CandidateStoryAnchor" ContentId="pane-candidate-story" Title="Candidate Story" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Candidate Story" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CandidateStoryOverview.Symbol}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CandidateStoryOverview.CompanyContext}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#253440" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8,4">
                                            <TextBlock Text="{Binding CandidateStoryOverview.State}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1" Background="#121C24" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,10,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CandidateStoryOverview.Status}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Teal}" />
                                                <TextBlock Text="{Binding CandidateStoryOverview.StatusDetail}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,12,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CandidateStoryOverview.Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2">
                                        <WrapPanel>
                                            <Border Width="210" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="First Seen" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.FirstSeen}" TextWrapping="Wrap" /></StackPanel>
                                            </Border>
                                            <Border Width="210" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="Latest" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.LatestSeen}" TextWrapping="Wrap" /></StackPanel>
                                            </Border>
                                            <Border Width="150" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="Move" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.Move}" /></StackPanel>
                                            </Border>
                                            <Border Width="165" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="Score Path" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.ScorePath}" /></StackPanel>
                                            </Border>
                                            <Border Width="230" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="Peak Score" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.PeakScore}" TextWrapping="Wrap" /></StackPanel>
                                            </Border>
                                            <Border Width="170" Background="#1A2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                                                <StackPanel><TextBlock Text="Evidence" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding CandidateStoryOverview.CaptureCount}" /></StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <DataGrid ItemsSource="{Binding CandidateStoryRows}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  AlternationCount="2"
                                                  Background="#17212B"
                                                  BorderBrush="{StaticResource PanelBorder}"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="38" />
                                                <DataGridTextColumn Header="Captured At" Binding="{Binding CapturedAt}" Width="175" />
                                                <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="60" />
                                                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="80" />
                                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="58" />
                                                <DataGridTextColumn Header="Move From First" Binding="{Binding MoveFromFirst}" Width="105" />
                                                <DataGridTextColumn Header="RVOL" Binding="{Binding RelativeVolume}" Width="68" />
                                                <DataGridTextColumn Header="Capture-Time Fact" Binding="{Binding CaptureNote}" Width="180" />
                                                <DataGridTextColumn Header="Later Annotation" Binding="{Binding LaterAnnotation}" Width="280" />
                                                <DataGridTextColumn Header="Source Context" Binding="{Binding SourceContext}" Width="320" />
                                                <DataGridTextColumn Header="Trust" Binding="{Binding Trust}" Width="200" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{Binding CandidateStoryEmptyLabel}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCandidateStoryPoints}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Grid.Row="4" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CandidateStoryOverview.Source}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CandidateStoryOverview.AsOf}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="READ ONLY | Capture-time facts and later annotations remain separately labeled." Foreground="{StaticResource Teal}" FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ScrollViewer Grid.Column="1" MaxHeight="54" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding CandidateStoryOverview.Warnings}" Foreground="{StaticResource Amber}" FontSize="10" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>

                    <avalon:LayoutAnchorablePane DockHeight="180" DockMinHeight="90">
                        <avalon:LayoutAnchorable x:Name="ActivityAnchor" ContentId="pane-activity" Title="Activity" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                    <ListBox ItemsSource="{Binding ActivityRows}" Background="#17212B" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                        <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" Foreground="{StaticResource Teal}" FontSize="10" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ScopeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="{Binding StateLabel}" Margin="10,0,0,0" FontSize="10" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StateLabel}" Value="HEALTHY">
                                                                            <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StateLabel}" Value="DEGRADED">
                                                                            <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StateLabel}" Value="UNAVAILABLE">
                                                                            <Setter Property="Foreground" Value="#F2868D" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ActivityCountLabel}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ActivitySourceLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="Newest source event appears first. Displaying this stream does not create, reorder, or persist events." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <Button Content="Diagnostics" Click="DiagnosticsButton_Click" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="DiagnosticsAnchor" ContentId="pane-diagnostics" Title="Diagnostics" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Diagnostics" FontSize="16" FontWeight="SemiBold" />
                                        <Border DockPanel.Dock="Right" Padding="7,3" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#263846" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Diagnostics.StatusLabel}" Value="HEALTHY">
                                                            <Setter Property="Background" Value="#173C37" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Diagnostics.StatusLabel}" Value="DEGRADED">
                                                            <Setter Property="Background" Value="#3A3524" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Diagnostics.StatusLabel}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Diagnostics.StatusLabel}" Value="HEALTHY">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Diagnostics.StatusLabel}" Value="DEGRADED">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" Margin="0,5,0,9">
                                        <TextBlock Text="{Binding Diagnostics.Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Diagnostics.CheckedAtLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Diagnostics.Components}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StateLabel}" Margin="12,0,0,0" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static contracts:HealthState.Healthy}">
                                                                            <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static contracts:HealthState.Degraded}">
                                                                            <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding CheckedAtLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Grid.Row="3" Text="Read-only engine health evidence. No repair, provider, broker, or execution action is available here." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" />
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="ResearchAnchor" ContentId="pane-research" Title="Research" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Technical Research" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TechnicalResearchOverview.SymbolLabel, StringFormat= • {0}}"
                                                           Foreground="{StaticResource Teal}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding TechnicalResearchOverview.AsOfLabel}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#253440" Padding="8,4" CornerRadius="3" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TechnicalResearchOverview.StateLabel}" FontWeight="SemiBold" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F2868D" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TechnicalResearchOverview.StateLabel}" Value="AVAILABLE">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TechnicalResearchOverview.StateLabel}" Value="STALE">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TechnicalResearchOverview.StateLabel}" Value="PARTIAL">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TechnicalResearchOverview.StateLabel}" Value="EMPTY">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding TechnicalResearchOverview.CountSummary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TechnicalResearchOverview.SourceLabel, StringFormat=Source: {0}}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding TechnicalResearchOverview.Summary}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding TechnicalResearchOverview.WarningSummary}"
                                                   Foreground="{StaticResource Amber}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2"
                                               Text="Research evidence only. Stored reports are not regenerated here, and no score, readiness, alert, watchlist, plan, or execution behavior changes."
                                               Foreground="{StaticResource Amber}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,8" />
                                    <TabControl x:Name="TechnicalResearchTabs" Grid.Row="3">
                                        <TabItem Header="Signals">
                                            <Grid Background="#17212B">
                                                <ListBox ItemsSource="{Binding TechnicalResearchEventRows}"
                                                         Background="#17212B"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource PanelBorder}"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                                <StackPanel>
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="150" />
                                                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Teal}" FontWeight="SemiBold" FontSize="10" Width="220" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding TimeframeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="75" />
                                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource Amber}" FontSize="10" Width="130" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding QualityLabel}" Foreground="{StaticResource TextPrimary}" FontSize="10" Width="80" />
                                                                        <TextBlock Text="{Binding EventIdLabel, StringFormat=ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding MetricsLabel}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding Notes}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{Binding TechnicalResearchEventsEmptyLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="24">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTechnicalResearchEvents}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Outcome Studies">
                                            <Grid Background="#17212B">
                                                <ListBox ItemsSource="{Binding TechnicalResearchStudyRows}"
                                                         Background="#17212B"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource PanelBorder}"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                                <StackPanel>
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="150" />
                                                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Teal}" FontWeight="SemiBold" FontSize="10" Width="220" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding TimeframeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="75" />
                                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource Amber}" FontSize="10" Width="130" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding EventIdLabel, StringFormat=ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding ReturnsLabel}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding ExcursionLabel}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                    <TextBlock Text="{Binding FlagsLabel}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                    <TextBlock Text="{Binding Notes}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{Binding TechnicalResearchStudiesEmptyLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="24">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTechnicalResearchStudies}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="WatchlistAnchor" ContentId="pane-watchlist" Title="Watchlist" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right"
                                                Background="#263846"
                                                BorderBrush="{StaticResource PanelBorder}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,4"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SavedWatchlistStateLabel}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SavedWatchlist.State}" Value="{x:Static contracts:SavedWatchlistState.Available}">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SavedWatchlist.State}" Value="{x:Static contracts:SavedWatchlistState.Stale}">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SavedWatchlist.State}" Value="{x:Static contracts:SavedWatchlistState.Partial}">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SavedWatchlist.State}" Value="{x:Static contracts:SavedWatchlistState.Unavailable}">
                                                                <Setter Property="Foreground" Value="#F07C82" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Saved Watchlist Evidence" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SavedWatchlistSourceLabel}"
                                                       Foreground="{StaticResource Teal}"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SavedWatchlistSourceLabel}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,10">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding SavedWatchlistAsOfLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding SavedWatchlistCountLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SavedWatchlistSummary}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                        <Border Background="#3A3524"
                                                BorderBrush="#715C24"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,5"
                                                Margin="0,7,0,0">
                                            <TextBlock Text="{Binding SavedWatchlistWarnings}"
                                                       Foreground="{StaticResource Amber}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock Text="Read-only historical artifact. It is not the active Hunter ranking, approval state, TradePlan, alert, or order instruction."
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SavedWatchlistEmptyState}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       HorizontalAlignment="Center"
                                                       Margin="12,18">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding SavedWatchlistItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#17212B"
                                                                BorderBrush="{StaticResource PanelBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="10"
                                                                Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <DockPanel>
                                                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding ScoreLabel}" Foreground="{StaticResource Teal}" FontSize="11" HorizontalAlignment="Right" />
                                                                        <TextBlock Text="{Binding PriceChangeLabel}" Foreground="{StaticResource TextPrimary}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding RankLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" Width="34" VerticalAlignment="Center" />
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="14" />
                                                                            <TextBlock Text="{Binding CompanyLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                                <WrapPanel Grid.Row="1" Margin="34,7,0,0">
                                                                    <TextBlock Text="{Binding VolumeLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,16,0" />
                                                                    <TextBlock Text="{Binding ClassificationLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,16,0" />
                                                                    <TextBlock Text="{Binding FreshnessLabel}" Foreground="{StaticResource Amber}" FontSize="10" Margin="0,0,16,0" />
                                                                    <TextBlock Text="{Binding SavedAtLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                                                </WrapPanel>
                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding HeadlineLabel}"
                                                                           Foreground="{StaticResource TextPrimary}"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap"
                                                                           Margin="34,7,0,0" />
                                                                <TextBlock Grid.Row="3"
                                                                           Text="{Binding NotesLabel}"
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           FontSize="10"
                                                                           FontStyle="Italic"
                                                                           TextWrapping="Wrap"
                                                                           Margin="34,4,0,0" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>

                    <avalon:LayoutAnchorablePane DockHeight="520" DockMinHeight="260">
                        <avalon:LayoutAnchorable x:Name="DailyWorkflowAnchor" ContentId="pane-daily-workflow" Title="Daily Workflow" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Daily Workflow Evidence" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DailyWorkflowSourceLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,12,0" />
                                                <TextBlock Text="{Binding DailyWorkflowSourceContextLabel}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,12,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DailyWorkflowStateLabel}" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DailyWorkflow.State}" Value="{x:Static contracts:DailyWorkflowEvidenceState.Available}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DailyWorkflow.State}" Value="{x:Static contracts:DailyWorkflowEvidenceState.Stale}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DailyWorkflow.State}" Value="{x:Static contracts:DailyWorkflowEvidenceState.Partial}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DailyWorkflow.State}" Value="{x:Static contracts:DailyWorkflowEvidenceState.Unavailable}">
                                                                    <Setter Property="Foreground" Value="#FF7B86" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DailyWorkflowScoreLabel}" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding DailyWorkflowAsOfLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding DailyWorkflow.Summary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding DailyWorkflowReviewLabel}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding DailyWorkflowPlanLabel}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding DailyWorkflowOutcomeLabel}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding DailyWorkflowReadinessLabel}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />

                                        <Border Background="#17212B" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,10,0,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DailyWorkflow.NextAction.Level}" Value="{x:Static contracts:DailyWorkflowStepLevel.Complete}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Teal}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DailyWorkflow.NextAction.Level}" Value="{x:Static contracts:DailyWorkflowStepLevel.Active}">
                                                            <Setter Property="BorderBrush" Value="#5BA8FF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DailyWorkflow.NextAction.Level}" Value="{x:Static contracts:DailyWorkflowStepLevel.Attention}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DailyWorkflow.NextAction.Level}" Value="{x:Static contracts:DailyWorkflowStepLevel.Blocked}">
                                                            <Setter Property="BorderBrush" Value="#FF7B86" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DailyWorkflow.NextAction.Title}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding DailyWorkflow.NextAction.Detail}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Capture Health  >  Morning Review  >  Watchlist Plans  >  Watchlist Report  >  Readiness Gate"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />

                                        <ItemsControl ItemsSource="{Binding DailyWorkflow.Steps}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="250" MinHeight="178" Background="#17212B" BorderThickness="1" CornerRadius="3" Padding="9" Margin="0,0,8,8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static contracts:DailyWorkflowStepLevel.Complete}">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Teal}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static contracts:DailyWorkflowStepLevel.Active}">
                                                                        <Setter Property="BorderBrush" Value="#5BA8FF" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static contracts:DailyWorkflowStepLevel.Attention}">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static contracts:DailyWorkflowStepLevel.Blocked}">
                                                                        <Setter Property="BorderBrush" Value="#FF7B86" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#75818C" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Light}" Value="{x:Static contracts:DailyWorkflowLight.Green}">
                                                                                    <Setter Property="Fill" Value="{StaticResource Teal}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Light}" Value="{x:Static contracts:DailyWorkflowLight.Blue}">
                                                                                    <Setter Property="Fill" Value="#5BA8FF" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Light}" Value="{x:Static contracts:DailyWorkflowLight.Yellow}">
                                                                                    <Setter Property="Fill" Value="{StaticResource Amber}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Light}" Value="{x:Static contracts:DailyWorkflowLight.Red}">
                                                                                    <Setter Property="Fill" Value="#FF7B86" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Dependency, StringFormat=Depends on: {0}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                                                            <TextBlock Text="{Binding Blocker, StringFormat=Blocker: {0}}" Foreground="{StaticResource Amber}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Expander Header="Warnings" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding DailyWorkflowWarningsLabel}" Foreground="{StaticResource Amber}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </Expander>
                                        <TextBlock Text="Read-only persisted evidence. Workflow lights describe operator discipline, not trade quality, readiness approval, or an order instruction."
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>

                    <avalon:LayoutAnchorablePane DockHeight="180" DockMinHeight="90">
                        <avalon:LayoutAnchorable x:Name="AutomationAnchor" ContentId="pane-automation" Title="Automation" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Research Monitoring" FontSize="16" FontWeight="SemiBold" />
                                        <Border DockPanel.Dock="Right" Padding="7,3" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#263846" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="HEALTHY">
                                                            <Setter Property="Background" Value="#173C37" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="DEGRADED">
                                                            <Setter Property="Background" Value="#3A3524" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="PAUSED">
                                                            <Setter Property="Background" Value="#3A3524" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="BLOCKED">
                                                            <Setter Property="Background" Value="#47272B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding MonitoringStatus.StateLabel}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="HEALTHY">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="DEGRADED">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="PAUSED">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MonitoringStatus.StateLabel}" Value="BLOCKED">
                                                                <Setter Property="Foreground" Value="#F2868D" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" Margin="0,6,0,12">
                                        <TextBlock Text="{Binding MonitoringStatus.Summary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MonitoringStatus.SourceDetail}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="Coverage" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding MonitoringStatus.MonitoredSymbolsLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                            <TextBlock Text="Cycles" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding MonitoringStatus.CompletedCyclesLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Last completed scan (UTC)" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding MonitoringStatus.LastCompletedLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="3" Text="Read-only research monitoring status. No scheduler, provider, broker, order, Paper, Live, or automatic-trading control is available here." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="OrdersAnchor" ContentId="pane-orders" Title="Orders" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Orders" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Order activity is unavailable in this simulation-only workstation shell." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Text="The shell does not send, cancel, or modify orders." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="PositionsAnchor" ContentId="pane-positions" Title="Positions" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Positions" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Position data is unavailable because no account data source is configured." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Text="A future read-only account source can appear here after explicit approval." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="ReplayEventsAnchor" ContentId="pane-replay-events" Title="Replay Events" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="Replay Context" FontSize="16" FontWeight="SemiBold" />
                                        <Border DockPanel.Dock="Right" Padding="7,3" CornerRadius="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#263846" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReplayContext.StatusLabel}" Value="AVAILABLE">
                                                            <Setter Property="Background" Value="#173C37" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ReplayContext.StatusLabel}" Value="NOT SELECTED">
                                                            <Setter Property="Background" Value="#3A3524" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ReplayContext.StatusLabel}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReplayContext.StatusLabel}" Value="AVAILABLE">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ReplayContext.StatusLabel}" Value="NOT SELECTED">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding ReplayContext.Summary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="Replay ID" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding ReplayContext.ReplayIdLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                            <TextBlock Text="As of (UTC)" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding ReplayContext.AsOfLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                            <TextBlock Text="Symbol" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding ReplayContext.SymbolLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Interval" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                            <TextBlock Text="{Binding ReplayContext.IntervalLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="3" Text="Read-only replay identity. This pane cannot select captures, alter replay identity, or change current research." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="ReviewOutcomesAnchor" ContentId="pane-review-outcomes" Title="Outcomes" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Alert Evidence &amp; Outcomes" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AlertEvidenceOverview.AsOfLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#253440" Padding="8,4" CornerRadius="3" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding AlertEvidenceOverview.StateLabel}" FontWeight="SemiBold" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F2868D" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlertEvidenceOverview.StateLabel}" Value="AVAILABLE">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AlertEvidenceOverview.StateLabel}" Value="EMPTY">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding AlertEvidenceOverview.CountSummary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AlertEvidenceOverview.Summary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2"
                                               Text="Research display only. Stored alert states and outcome classifications are not recalculated; no thresholds or source files are changed."
                                               Foreground="{StaticResource Amber}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,8" />
                                    <TabControl x:Name="AlertEvidenceTabs" Grid.Row="3">
                                        <TabItem Header="Active / Pending">
                                            <Grid Background="#17212B">
                                                <ListBox ItemsSource="{Binding AlertRows}"
                                                         Background="#17212B"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource PanelBorder}"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                                <StackPanel>
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="155" />
                                                                        <TextBlock Text="{Binding SymbolLabel}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10" Width="75" />
                                                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Teal}" FontSize="10" Width="120" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource Amber}" FontWeight="SemiBold" FontSize="10" Width="120" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding AlertIdLabel, StringFormat=ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{Binding AlertRowsEmptyLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="24">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAlertRows}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Recorded Outcomes">
                                            <Grid Background="#17212B">
                                                <ListBox ItemsSource="{Binding OutcomeRows}"
                                                         Background="#17212B"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource PanelBorder}"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                                <StackPanel>
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="155" />
                                                                        <TextBlock Text="{Binding SymbolLabel}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10" Width="75" />
                                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource Teal}" FontSize="10" Width="135" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding ClassificationLabel}" Foreground="{StaticResource Amber}" FontWeight="SemiBold" FontSize="10" Width="205" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding AlertIdLabel, StringFormat=ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{Binding OutcomeRowsEmptyLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="24">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasOutcomeRows}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>
                </avalon:LayoutPanel>
            </avalon:LayoutRoot>
        </avalon:DockingManager>

        <Border Grid.Row="2" Background="#121C24" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding WorkspaceNarrative}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundStatusDetail}" Foreground="{StaticResource TextMuted}" FontSize="10" />
            </DockPanel>
        </Border>

        <Popup IsOpen="{Binding IsHealthOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=HealthButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="340" Padding="14" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="System Health" FontSize="15" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Health.Components}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding State}" Foreground="{StaticResource Amber}" DockPanel.Dock="Right" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Open Diagnostics" Click="DiagnosticsButton_Click" Margin="0,10,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="PanesPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=PanesButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="360" Padding="12" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Workspace Panes" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Close hides a pane. Remove permanently deletes that pane instance from this workspace." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <ItemsControl ItemsSource="{Binding Registry.Panes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Symbol}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Open" Tag="{Binding InstanceId}" Click="ReopenPaneButton_Click" />
                                        <Button Content="Remove" Tag="{Binding InstanceId}" Click="RemovePaneButton_Click" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ApplicationMenuPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=ApplicationMenuButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="300" Padding="12" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Background Collection" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BackgroundStatusDetail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <Button Content="{Binding MonitoringToggleLabel}" Click="PauseOrResumeButton_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Run Scan Now" Click="RunScanNowButton_Click" HorizontalAlignment="Stretch" Margin="3,5,3,0" />
                    <Button Content="View System Status" Click="ViewSystemStatusButton_Click" HorizontalAlignment="Stretch" Margin="3,5,3,0" />
                    <Separator Margin="3,10" />
                    <Button Content="Exit Momentum Hunter" Click="ExitApplicationButton_Click" HorizontalAlignment="Stretch" Margin="3,0" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="CommandPalettePopup"
               IsOpen="{Binding IsCommandPaletteOpen, Mode=TwoWay}"
               Placement="Center"
               PlacementTarget="{Binding ElementName=Root}"
               StaysOpen="False"
               AllowsTransparency="True"
               Opened="CommandPalettePopup_Opened"
               Closed="CommandPalettePopup_Closed"
               DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="520" Padding="16" Background="#1B2731" BorderBrush="{StaticResource Teal}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Command Palette" FontSize="16" FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,8">
                        <TextBox x:Name="CommandPaletteSearchBox"
                                 Background="#10161D"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}"
                                 Padding="8"
                                 Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="CommandPaletteSearchBox_PreviewKeyDown" />
                        <TextBlock Text="Type a symbol or command"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CommandPaletteSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ListBox x:Name="CommandPaletteResultsList"
                             ItemsSource="{Binding CommandPaletteResults}"
                             SelectedItem="{Binding SelectedCommandPaletteItem, Mode=TwoWay}"
                             Background="#17212B"
                             BorderBrush="{StaticResource PanelBorder}"
                             Foreground="{StaticResource TextPrimary}"
                             MaxHeight="340"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="CommandPaletteResultsList_PreviewKeyDown"
                             MouseDoubleClick="CommandPaletteResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Detail}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding CommandPaletteEmptyText}"
                               Foreground="{StaticResource Amber}"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCommandPaletteResults}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
