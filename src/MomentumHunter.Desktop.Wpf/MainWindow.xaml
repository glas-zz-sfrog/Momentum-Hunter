                                            <TabItem Header="Execution Quality">
                                                <Grid Margin="10">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1*" /></Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding SelectedShadowTrade.Execution.Quality.FactorDisplay}" TextWrapping="Wrap" />
                                                    <DataGrid Grid.Row="1" Margin="0,10,0,0"
                                                              ItemsSource="{Binding SelectedShadowTrade.Execution.Quality.TechnicalCodes}"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              CanUserAddRows="False"
                                                              Background="#17212B">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="80" />
                                                            <DataGridTextColumn Header="Code" Binding="{Binding EventType}" Width="150" />
                                                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                                                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                        <avalon:LayoutAnchorable x:Name="ReviewOutcomesAnchor" ContentId="pane-review-outcomes" Title="Outcomes" CanClose="True" CanFloat="True">
                            <Border Background="{StaticResource PanelBackground}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Alert Evidence &amp; Outcomes" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AlertEvidenceOverview.AsOfLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#253440" Padding="8,4" CornerRadius="3" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding AlertEvidenceOverview.StateLabel}" FontWeight="SemiBold" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#F2868D" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlertEvidenceOverview.StateLabel}" Value="AVAILABLE">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AlertEvidenceOverview.StateLabel}" Value="EMPTY">
                                                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding AlertEvidenceOverview.CountSummary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AlertEvidenceOverview.Summary}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2"
                                               Text="Research display only. Stored alert states and outcome classifications are not recalculated; no thresholds or source files are changed."
                                               Foreground="{StaticResource Amber}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,8" />
                                    <TabControl x:Name="AlertEvidenceTabs" Grid.Row="3">
                                        <TabItem Header="Active / Pending">
                                            <Grid Background="#17212B">
                                                <ListBox ItemsSource="{Binding AlertRows}"
                                                         Background="#17212B"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource PanelBorder}"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                                <StackPanel>
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="155" />
                                                                        <TextBlock Text="{Binding SymbolLabel}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10" Width="75" />
                                                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Teal}" FontSize="10" Width="120" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource Amber}" FontWeight="SemiBold" FontSize="10" Width="120" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding AlertIdLabel, StringFormat=ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{Binding AlertRowsEmptyLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="24">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAlertRows}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Recorded Outcomes">
                                            <Grid Background="#17212B">
                                                <ListBox ItemsSource="{Binding OutcomeRows}"
                                                         Background="#17212B"
                                                         Foreground="{StaticResource TextPrimary}"
                                                         BorderBrush="{StaticResource PanelBorder}"
                                                         HorizontalContentAlignment="Stretch"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="7,6">
                                                                <StackPanel>
                                                                    <WrapPanel>
                                                                        <TextBlock Text="{Binding TimestampLabel}" Foreground="{StaticResource TextMuted}" FontSize="10" Width="155" />
                                                                        <TextBlock Text="{Binding SymbolLabel}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="10" Width="75" />
                                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource Teal}" FontSize="10" Width="135" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding ClassificationLabel}" Foreground="{StaticResource Amber}" FontWeight="SemiBold" FontSize="10" Width="205" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding AlertIdLabel, StringFormat=ID: {0}}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                                    </WrapPanel>
                                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{Binding OutcomeRowsEmptyLabel}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="24">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasOutcomeRows}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>
                </avalon:LayoutPanel>
            </avalon:LayoutRoot>
        </avalon:DockingManager>

        <Border Grid.Row="2" Background="#121C24" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding WorkspaceNarrative}" Foreground="{StaticResource TextMuted}" FontSize="10" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundStatusDetail}" Foreground="{StaticResource TextMuted}" FontSize="10" />
            </DockPanel>
        </Border>

        <Popup IsOpen="{Binding IsHealthOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=HealthButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="340" Padding="14" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="System Health" FontSize="15" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Health.Components}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding State}" Foreground="{StaticResource Amber}" DockPanel.Dock="Right" />
                                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Open Diagnostics" Click="DiagnosticsButton_Click" Margin="0,10,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="PanesPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=PanesButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="360" Padding="12" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Workspace Panes" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="The X in a pane title hides it. Hidden panes can be reopened here; visible panes can be brought to the front." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Registry.Panes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding VisibilityLabel}" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Teal}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Content="{Binding VisibilityActionLabel}"
                                                Tag="{Binding InstanceId}"
                                                DockPanel.Dock="Right"
                                                MinWidth="58"
                                                Height="27"
                                                Padding="9,2"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="ShowPaneButton_Click" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ApplicationMenuPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=ApplicationMenuButton}" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding DataContext, ElementName=Root}">
            <Border Width="300" Padding="12" Background="#1B2731" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Background Collection" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BackgroundStatusDetail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <Button Content="{Binding MonitoringToggleLabel}" Click="PauseOrResumeButton_Click" HorizontalAlignment="Stretch" />
                    <Button Content="Run Scan Now" Click="RunScanNowButton_Click" HorizontalAlignment="Stretch" Margin="3,5,3,0" />
                    <Button Content="View System Status" Click="ViewSystemStatusButton_Click" HorizontalAlignment="Stretch" Margin="3,5,3,0" />
                    <Separator Margin="3,10" />
                    <Button Content="Exit Momentum Hunter" Click="ExitApplicationButton_Click" HorizontalAlignment="Stretch" Margin="3,0" />
                </StackPanel>
            </Border>
        </Popup>

        <Grid x:Name="CommandPaletteOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="100"
              Background="#66000000"
              FocusManager.IsFocusScope="True"
              IsVisibleChanged="CommandPaletteOverlay_IsVisibleChanged"
              MouseLeftButtonDown="CommandPaletteOverlay_MouseLeftButtonDown">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCommandPaletteOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Width="520"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1B2731"
                    BorderBrush="{StaticResource Teal}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Command Palette" FontSize="16" FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,8">
                        <TextBox x:Name="CommandPaletteSearchBox"
                                 Background="#10161D"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource PanelBorder}"
                                 Padding="8"
                                 Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="CommandPaletteSearchBox_PreviewKeyDown" />
                        <TextBlock Text="Current Hunter symbol or command"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CommandPaletteSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding CommandPaletteScopeLabel}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="10"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap" />
                    <ListBox x:Name="CommandPaletteResultsList"
                             ItemsSource="{Binding CommandPaletteResults}"
                             SelectedItem="{Binding SelectedCommandPaletteItem, Mode=TwoWay}"
                             Background="#17212B"
                             BorderBrush="{StaticResource PanelBorder}"
                             Foreground="{StaticResource TextPrimary}"
                             MaxHeight="340"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="CommandPaletteResultsList_PreviewKeyDown"
                             MouseDoubleClick="CommandPaletteResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Detail}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding CommandPaletteEmptyText}"
                               Foreground="{StaticResource Amber}"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCommandPaletteResults}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
